# Supabase — get these from your Supabase project settings
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe — get these from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create products in Stripe and paste price IDs here
STRIPE_PRICE_CLASSROOM_MONTHLY=price_...
STRIPE_PRICE_CLASSROOM_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# Site URL — used for redirects and webhook validation
PUBLIC_SITE_URL=https://standardcraft.netlify.app

# Analytics (optional) — set provider + token to enable
# PUBLIC_ANALYTICS_PROVIDER=plausible
# PUBLIC_ANALYTICS_DOMAIN=standardcraft.netlify.app
