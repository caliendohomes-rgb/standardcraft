# StandardCraft production environment variables
# Do not commit real secrets.

# Public site URL used for canonical tags, sitemap, and Open Graph URLs.
SITE_URL=https://standardcraftny.com

# Supabase production auth/data setup, not used by the current static demo.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server-side checkout setup, not used by the current static demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASSROOM_MONTHLY=
STRIPE_PRICE_CLASSROOM_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Optional operational contact target for form notifications.
STANDARDCRAFT_SUPPORT_EMAIL=
