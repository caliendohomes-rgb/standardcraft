---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title = 'StandardCraft — NYS Standards-Aligned Classroom Resources',
  description = 'Classroom-ready lesson plans and worksheets grounded in NYS Next Generation Standards. Zero invented codes. Verified alignment records. Built for New York educators.',
  canonical,
  noIndex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="StandardCraft" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {noIndex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }
    <slot name="head-schema" />
  </head>
  <body class="site-shell font-sans antialiased">

    <header class="border-b sticky top-0 z-50 backdrop-blur" style="background: rgba(251, 247, 239, 0.94); border-color: var(--sc-border);">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between min-h-16 gap-4">
        <a href="/" class="font-bold text-lg tracking-tight text-[#172438] hover:text-[#376b9b] transition-colors">
          Standard<span style="color: var(--sc-blue);">Craft</span>
          <span class="hidden sm:block text-xs font-semibold text-[#415066]">NYS-aligned classroom resources</span>
        </a>
        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href="/#why-us" class="site-nav-link transition-colors">Why us</a>
          <a href="/#how-it-works" class="site-nav-link transition-colors">How it works</a>
          <a href="/resources" class="site-nav-link transition-colors">Preview resources</a>
          <a href="/free-resource-library" class="site-nav-link transition-colors">Free library</a>
        </div>
        <div class="hidden md:flex items-center gap-3">
          <a href="/pricing" class="text-sm site-nav-link transition-colors">Pricing</a>
          <!-- Auth-aware nav: both rendered, JS shows correct one -->
          <a id="nav-signin" href="/sign-in" class="hidden text-sm site-nav-link transition-colors">Sign in</a>
          <a id="nav-dashboard" href="/dashboard" class="hidden text-sm site-nav-link transition-colors">Dashboard</a>
          <a id="nav-start" href="/claim-free" class="btn-primary text-sm py-2 px-4">Start free</a>
        </div>
        <details class="mobile-menu md:hidden relative">
          <summary class="list-none cursor-pointer rounded-lg border px-3 py-2 text-sm font-bold" style="border-color: var(--sc-border); background: white;">Menu</summary>
          <div class="absolute right-0 top-full mt-2 w-64 rounded-lg border bg-white p-4 shadow-xl grid gap-3 text-sm" style="border-color: var(--sc-border);">
            <a href="/#how-it-works" class="site-nav-link">How it works</a>
            <a href="/resources" class="site-nav-link">Preview resources</a>
            <a href="/free-resource-library" class="site-nav-link">Free library</a>
            <a href="/pricing" class="site-nav-link">Pricing</a>
            <a href="/school-inquiry" class="site-nav-link">Schools</a>
            <a href="/sign-in" class="site-nav-link">Sign in</a>
            <a href="/claim-free" class="btn-primary text-sm py-2 px-4 justify-center">Start free</a>
          </div>
        </details>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-[#1e2a2d] mt-24 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between gap-8">
          <div>
            <div class="font-bold text-lg mb-2">Standard<span class="text-teal-400">Craft</span></div>
            <p class="text-sm text-[#4a5f63] max-w-xs leading-relaxed">
              Original, educator-reviewed resources built from publicly available New York State standards frameworks.
              Designed to support classroom planning and instruction.
            </p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm">
            <div>
              <div class="font-semibold mb-3 text-[#e8f0f0]">Product</div>
              <ul class="space-y-2 text-[#4a5f63]">
                <li><a href="/#why-us" class="hover:text-teal-400 transition-colors">Why StandardCraft</a></li>
                <li><a href="/resources" class="hover:text-teal-400 transition-colors">Resource Library</a></li>
                <li><a href="/pricing" class="hover:text-teal-400 transition-colors">Pricing</a></li>
                <li><a href="/school-inquiry" class="hover:text-teal-400 transition-colors">Schools &amp; Districts</a></li>
              </ul>
            </div>
            <div>
              <div class="font-semibold mb-3 text-[#e8f0f0]">Standards</div>
              <ul class="space-y-2 text-[#4a5f63]">
                <li><a href="/resources?subject=ELA" class="hover:text-teal-400 transition-colors">ELA / Literacy</a></li>
                <li><a href="/resources?subject=Math" class="hover:text-teal-400 transition-colors">Mathematics</a></li>
                <li><a href="/resources?subject=Science" class="hover:text-teal-400 transition-colors">Science / NYSSLS</a></li>
                <li><a href="/resources?subject=Social+Studies" class="hover:text-teal-400 transition-colors">Social Studies</a></li>
              </ul>
            </div>
            <div>
              <div class="font-semibold mb-3 text-[#e8f0f0]">Legal</div>
              <ul class="space-y-2 text-[#4a5f63]">
                <li><a href="/privacy" class="hover:text-teal-400 transition-colors">Privacy Policy</a></li>
                <li><a href="/terms" class="hover:text-teal-400 transition-colors">Terms of Service</a></li>
                <li><a href="/data-security" class="hover:text-teal-400 transition-colors">Data Security</a></li>
                <li><a href="/refunds-and-assurance" class="hover:text-teal-400 transition-colors">Refunds &amp; Assurance</a></li>
                <li><a href="/contact" class="hover:text-teal-400 transition-colors">Contact</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-10 pt-8 border-t border-[#1e2a2d] space-y-3 text-xs text-[#3a5055] leading-relaxed">
          <p>
            StandardCraft provides original, educator-reviewed resources built from publicly available New York State standards frameworks.
            StandardCraft is independent and is not affiliated with, endorsed by, or sponsored by the New York State Education Department.
            Resources are designed to support classroom planning and instruction and do not replace district curriculum or teacher professional judgment.
          </p>
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <p>© {new Date().getFullYear()} StandardCraft. All rights reserved.</p>
            <p>NYS standard codes cited from official publicly available NYSED sources.</p>
          </div>
        </div>
      </div>
    </footer>

    <script>
      // Auth-aware nav: check for active Supabase session cookie client-side
      (function () {
        const hasCookie = document.cookie.split(';').some(c => c.trim().startsWith('sb-') && c.includes('-auth-token='));
        const signIn = document.getElementById('nav-signin');
        const dashboard = document.getElementById('nav-dashboard');
        const start = document.getElementById('nav-start');
        if (hasCookie) {
          if (dashboard) dashboard.classList.remove('hidden');
          if (start) start.classList.add('hidden');
        } else {
          if (signIn) signIn.classList.remove('hidden');
        }
      })();
    </script>
  </body>
</html>
