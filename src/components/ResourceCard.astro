---
interface Props {
  resource: {
    id: string;
    data: {
      title: string;
      grade: string;
      grade_band: string;
      subject: string;
      resource_type: string;
      standards_framework: string;
      standards: Array<{ code: string; text: string; source: string }>;
      alignment_confidence: string;
      marketplace_title: string;
      marketplace_tags: string[];
      has_sdi_block: boolean;
      has_mll_block: boolean;
      human_review: string;
    };
  };
}

const { resource } = Astro.props;
const { data, id: slug } = resource;

const subjectColors: Record<string, string> = {
  'ELA': 'tag-teal',
  'Literacy': 'tag-teal',
  'Math': 'tag-purple',
  'Mathematics': 'tag-purple',
  'Science': 'tag-amber',
  'Social Studies': 'tag-gray',
  'Computer Science': 'tag-teal',
  'Computer Science & Digital Fluency': 'tag-teal',
  'Cybersecurity & AI Education': 'tag-purple',
  'Health': 'tag-gray',
  'Health & PE': 'tag-gray',
  'Arts': 'tag-amber',
  'World Languages': 'tag-gray',
  'CDOS': 'tag-gray',
  'CDOS & Career Readiness': 'tag-gray',
  'Cross-Content SDI & IEP Support': 'tag-purple',
};

const subjectColor = subjectColors[data.subject] ?? 'tag-gray';
const isMathReview = data.human_review === 'Math teacher review pilot eligible';
const primaryStandard = data.standards[0];
---

<a href={`/resources/${slug}`} class="card group flex flex-col gap-4 cursor-pointer no-underline">
  <div class="flex items-start justify-between gap-3">
    <div class="flex flex-wrap gap-2">
      <span class={subjectColor}>{data.subject}</span>
      <span class="tag tag-gray">Grade {data.grade}</span>
      <span class="tag tag-gray">{data.grade_band}</span>
    </div>
    <span class="tag tag-gray text-nowrap shrink-0">{data.resource_type}</span>
  </div>

  <div>
    <h3 class="font-semibold text-[#172438] group-hover:text-[#376b9b] transition-colors leading-snug">
      {data.title}
    </h3>
    {primaryStandard && (
      <div class="mt-2 flex items-center gap-2">
        <span class="font-mono text-xs text-[#0f766e] bg-[#dce8d5] px-2 py-0.5 rounded border border-[#cadbc2]">
          {primaryStandard.code}
        </span>
        <span class="text-xs text-[#4a5f63] truncate">{data.standards_framework}</span>
      </div>
    )}
  </div>

  <div class="flex flex-wrap gap-2 mt-auto pt-2 border-t border-[#e4dac8]">
    {data.has_sdi_block && (
      <span class="tag tag-gray">SDI ✓</span>
    )}
    {data.has_mll_block && (
      <span class="tag tag-gray">MLL/ELL ✓</span>
    )}
    {isMathReview && (
      <span class="tag tag-teal">Math Review Pilot</span>
    )}
    <span class={`tag ml-auto ${data.alignment_confidence === 'Full Trust' ? 'tag-teal' : 'tag-amber'}`}>
      {data.alignment_confidence}
    </span>
  </div>

  <!-- Trust line -->
  <p class="text-[11px] text-[#3a5055] leading-relaxed -mt-1">
    Original resource · Alignment record included · {isMathReview ? 'Math teacher review pilot' : 'Validated for classroom use'}
  </p>
</a>
