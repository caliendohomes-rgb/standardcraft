---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  heading?: string;
  items: FaqItem[];
  id?: string;
}

const {
  heading = 'Common questions',
  items,
  id = 'faq',
} = Astro.props;

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
});
---

<section id={id} class="border-t border-[#1e2a2d] py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-label mb-4">FAQ</div>
    <h2 class="text-2xl font-bold mb-10">{heading}</h2>
    <div class="space-y-3">
      {items.map(item => (
        <details class="group rounded-xl border border-[#1e2a2d] bg-[#111618] overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-semibold text-sm text-[#e8f0f0] hover:text-teal-300 transition-colors">
            {item.q}
            <span class="text-teal-500 shrink-0 transition-transform group-open:rotate-45 text-lg leading-none">+</span>
          </summary>
          <div class="px-5 pb-5 text-sm text-[#4a5f63] leading-relaxed border-t border-[#1e2a2d] pt-4">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={schemaJson}></script>
