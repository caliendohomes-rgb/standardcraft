---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  heading?: string;
  items: FaqItem[];
  id?: string;
}

const {
  heading = 'Common questions',
  items,
  id = 'faq',
} = Astro.props;

import { jsonLd } from '../lib/jsonld';

const schemaJson = jsonLd({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
});
---

<section id={id} class="border-t py-10 sm:py-14" style="border-color: var(--sc-border);">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-label mb-3">FAQ</div>
    <h2 class="text-2xl font-bold mb-6 text-[#172438]">{heading}</h2>
    <div class="space-y-3">
      {items.map(item => (
        <details class="group card p-0 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-semibold text-sm text-[#172438] hover:text-[#376b9b] transition-colors">
            {item.q}
            <span class="shrink-0 transition-transform group-open:rotate-45 text-lg leading-none font-bold" style="color: var(--sc-gold);">+</span>
          </summary>
          <div class="px-5 pb-5 text-sm text-[#415066] leading-relaxed border-t pt-4" style="border-color: var(--sc-border);">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={schemaJson}></script>
