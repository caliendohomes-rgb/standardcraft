---
const badges = [
  { mark: '✦', label: 'Original resources' },
  { mark: '✓', label: 'Educator-reviewed' },
  { mark: '◎', label: 'Built from NYS standards' },
  { mark: '≡', label: 'Alignment notes included' },
  { mark: '◻', label: 'No student data required' },
  { mark: '⊘', label: 'Independent from NYSED' },
];
---

<div class="border-b border-[#1e2a2d] bg-[#0d1314]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5">
      {badges.map((b, i) => (
        <>
          <div class="flex items-center gap-1.5">
            <span class="text-teal-500 text-[11px] font-bold leading-none">{b.mark}</span>
            <span class="text-[11px] font-medium tracking-wide text-[#5a7478] uppercase">{b.label}</span>
          </div>
          {i < badges.length - 1 && (
            <span class="hidden sm:inline text-[#1e2a2d] select-none" aria-hidden="true">·</span>
          )}
        </>
      ))}
    </div>
  </div>
</div>
