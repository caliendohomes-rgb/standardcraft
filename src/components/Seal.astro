---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = '', size = 40 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="StandardCraft seal"
>
  <circle cx="24" cy="24" r="23" fill="var(--sc-ivory)" stroke="var(--sc-navy)" stroke-width="1.25" />
  <circle cx="24" cy="24" r="18.5" fill="none" stroke="var(--sc-gold)" stroke-width="0.9" />
  <g stroke="var(--sc-gold)" stroke-width="1.4" stroke-linecap="round">
    <line x1="24" y1="2.5" x2="24" y2="5.5" />
    <line x1="24" y1="42.5" x2="24" y2="45.5" />
    <line x1="2.5" y1="24" x2="5.5" y2="24" />
    <line x1="42.5" y1="24" x2="45.5" y2="24" />
  </g>
  <text
    x="24"
    y="31"
    text-anchor="middle"
    font-family="var(--sc-font-display)"
    font-weight="600"
    font-size="20"
    fill="var(--sc-navy)"
  >S</text>
</svg>
