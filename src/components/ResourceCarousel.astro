---
import type { CollectionEntry } from 'astro:content';

interface Props {
  resources: CollectionEntry<'resources'>[];
}
const { resources } = Astro.props;

const subjectColors: Record<string, string> = {
  ELA: 'tag-teal',
  Math: 'tag-purple',
  Science: 'tag-amber',
  'Social Studies': 'tag-gray',
  'Computer Science & Digital Fluency': 'tag-teal',
  'World Languages': 'tag-gray',
  Arts: 'tag-amber',
  'Health & PE': 'tag-gray',
  'CDOS & Career Readiness': 'tag-gray',
  'Cross-Content SDI & IEP Support': 'tag-purple',
};

// Feature-highlight slides interleaved with real resource previews.
const featureSlides = [
  {
    kicker: 'Inside every resource',
    title: 'An alignment record you can defend',
    body: 'The exact NYS standard code and its official NYSED source — ready to hand to an evaluator or IEP team.',
  },
  {
    kicker: 'Built-in supports',
    title: 'SDI + MLL/ELL, not afterthoughts',
    body: 'SDI across content, methodology, and delivery — plus MLL/ELL scaffolds by NYSESLAT proficiency level.',
  },
];

// Build an interleaved slide list: 3 resources, a feature, 3 resources, a feature, ...
type Slide =
  | { kind: 'resource'; entry: CollectionEntry<'resources'> }
  | { kind: 'feature'; data: (typeof featureSlides)[number] };

const slides: Slide[] = [];
let fi = 0;
resources.forEach((entry, i) => {
  slides.push({ kind: 'resource', entry });
  if ((i + 1) % 3 === 0 && fi < featureSlides.length) {
    slides.push({ kind: 'feature', data: featureSlides[fi++] });
  }
});
featureSlides.slice(fi).forEach((data) => slides.push({ kind: 'feature', data }));
---

<div class="sc-carousel" data-interval="5600" aria-roledescription="carousel" aria-label="Sample resources and features">
  <div class="sc-carousel-viewport">
    <div class="sc-carousel-track">
      {slides.map((slide, i) => (
        <div
          class="sc-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
          data-index={i}
        >
          {slide.kind === 'resource' ? (
            (() => {
              const { data, slug } = slide.entry;
              const std = data.standards[0];
              const isMath = data.human_review === 'Math teacher review pilot eligible';
              const subjColor = subjectColors[data.subject] ?? 'tag-gray';
              return (
                <a href={`/resources/${slug}`} class="card sc-card no-underline block">
                  <div class="flex items-center justify-between mb-3">
                    <span class={`tag ${subjColor}`}>{data.subject}</span>
                    <span class="tag tag-gray">{data.grade_band}</span>
                  </div>
                  <div class="text-[11px] font-bold uppercase tracking-wider text-[#376b9b] mb-1">{data.resource_type}</div>
                  <h3 class="font-display text-xl font-semibold text-[#172438] mb-3 leading-snug">{data.title}</h3>
                  {std && (
                    <div class="flex items-center gap-2 mb-3">
                      <span class="font-mono text-xs text-[#0f766e] bg-[#dce8d5] px-2 py-0.5 rounded border border-[#cadbc2]">{std.code}</span>
                      <span class="text-xs text-[#415066] truncate">{data.standards_framework}</span>
                    </div>
                  )}
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {data.has_sdi_block && <span class="tag tag-gray text-[11px]">SDI ✓</span>}
                    {data.has_mll_block && <span class="tag tag-gray text-[11px]">MLL/ELL ✓</span>}
                    {isMath && <span class="tag tag-teal text-[11px]">Math Review Pilot</span>}
                    <span class={`tag text-[11px] ${data.alignment_confidence === 'Full Trust' ? 'tag-teal' : 'tag-amber'}`}>{data.alignment_confidence}</span>
                  </div>
                  <span class="text-sm font-semibold text-[#376b9b]">See the alignment record →</span>
                </a>
              );
            })()
          ) : (
            <div class="card sc-card sc-feature">
              <div class="sc-feature-mark" aria-hidden="true">◆</div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-[#376b9b] mb-2">{slide.data.kicker}</div>
              <h3 class="font-display text-2xl font-semibold text-[#172438] mb-3 leading-snug">{slide.data.title}</h3>
              <p class="text-sm text-[#415066] leading-relaxed">{slide.data.body}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="sc-carousel-controls">
    <button type="button" class="sc-arrow sc-prev" aria-label="Previous resource">‹</button>
    <div class="sc-dots" role="tablist" aria-label="Choose slide">
      {slides.map((_, i) => (
        <button type="button" class="sc-dot" role="tab" data-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
      ))}
    </div>
    <button type="button" class="sc-arrow sc-next" aria-label="Next resource">›</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.sc-carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.sc-carousel-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.sc-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.sc-dot'));
    const prev = root.querySelector<HTMLButtonElement>('.sc-prev');
    const next = root.querySelector<HTMLButtonElement>('.sc-next');
    if (!track || slides.length === 0) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Number(root.dataset.interval) || 4800;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function render() {
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        d.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    }
    function go(i: number) { index = (i + slides.length) % slides.length; render(); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() { if (!reduce && !timer) timer = setInterval(() => go(index + 1), interval); }

    prev?.addEventListener('click', () => { go(index - 1); stop(); start(); });
    next?.addEventListener('click', () => { go(index + 1); stop(); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); stop(); start(); }));

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Subtle 3D pointer-tilt on the active card (immersive flare)
    const viewport = root.querySelector<HTMLElement>('.sc-carousel-viewport');
    if (viewport && !reduce) {
      viewport.addEventListener('mousemove', (e) => {
        const card = slides[index]?.querySelector<HTMLElement>('.sc-card');
        if (!card) return;
        const r = viewport.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `rotateY(${px * 3.5}deg) rotateX(${-py * 3.5}deg)`;
      });
      viewport.addEventListener('mouseleave', () => {
        const card = slides[index]?.querySelector<HTMLElement>('.sc-card');
        if (card) card.style.transform = '';
      });
    }

    render();
    start();
  });
</script>
