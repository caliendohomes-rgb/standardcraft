---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allResources = await getCollection('resources');
const resourceCount = allResources.length;
const subjectCount = new Set(allResources.map(r => r.data.subject)).size;

const plans = [
  {
    key: 'free',
    name: 'Sampler',
    monthly: 'Free',
    annual: 'Free',
    monthlyNote: 'No card required',
    annualNote: 'No card required',
    save: '',
    creditsLabel: '1 signup credit',
    features: [
      '1 resource download',
      `Browse all ${resourceCount} resources`,
      'SDI + MLL/ELL blocks included',
      'Alignment record included',
    ],
    cta: 'Claim my free resource',
    ctaHref: '/claim-free',
    primary: false,
    badge: null,
  },
  {
    key: 'classroom',
    name: 'Classroom',
    monthly: '$29',
    annual: '$210',
    monthlyNote: '/month',
    annualNote: '/year',
    save: 'Save $138/yr · $17.50/mo',
    creditsLabel: '8 credits/month',
    features: [
      '8 resource downloads/month',
      `All ${subjectCount} NYS subject areas`,
      'SDI + MLL/ELL blocks on every resource',
      'Alignment records for admin',
      'Email support',
    ],
    cta: 'Start Classroom',
    ctaHref: null,
    ctaPlan: 'classroom',
    primary: false,
    badge: null,
  },
  {
    key: 'pro',
    name: 'Pro',
    monthly: '$69',
    annual: '$690',
    monthlyNote: '/month',
    annualNote: '/year',
    save: 'Save $138/yr · $57.50/mo',
    creditsLabel: '20 credits/month',
    features: [
      '20 resource downloads/month',
      `All ${subjectCount} NYS subject areas`,
      'SDI + MLL/ELL blocks on every resource',
      'Priority email support',
      'Early access to new resources',
    ],
    cta: 'Start Pro',
    ctaHref: null,
    ctaPlan: 'pro',
    primary: true,
    badge: 'Most Popular',
  },
  {
    key: 'school',
    name: 'School',
    monthly: '$249+',
    annual: '$249+',
    monthlyNote: '/month',
    annualNote: '/month',
    save: 'Annual & PO billing available',
    creditsLabel: 'Pooled credits · admin panel',
    features: [
      'Pooled credit allocation',
      'Multi-teacher admin panel',
      'Ed Law §2-d FERPA data agreement',
      'Dedicated onboarding',
      'Custom resource requests',
      'Invoice / PO billing available',
    ],
    cta: 'Request a quote',
    ctaHref: '/school-inquiry',
    primary: false,
    badge: null,
  },
];
---

<Layout
  title="Pricing — StandardCraft | NYS-Aligned Classroom Resources from $0"
  description="StandardCraft plans start free. Original, educator-reviewed NYS-aligned resources. No student data required. Classroom $29/mo · Pro $69/mo · School plans available."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Is StandardCraft affiliated with NYSED?', acceptedAnswer: { '@type': 'Answer', text: 'No. StandardCraft is an independent resource platform and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. Our resources are built from publicly available standards frameworks and are designed to support classroom planning.' } },
      { '@type': 'Question', name: 'Do I need to enter student data?', acceptedAnswer: { '@type': 'Answer', text: 'No. StandardCraft does not require student personally identifiable information to browse, download, or use teacher resources. StandardCraft is designed for teacher resource access, not student data collection.' } },
      { '@type': 'Question', name: 'Are the resources original?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. StandardCraft resources are created as original instructional supports — not recycled worksheets or copies of marketplace content. Each resource is reviewed for instructional clarity, classroom usability, and standards connection before publication.' } },
      { '@type': 'Question', name: 'Do these resources replace my district curriculum?', acceptedAnswer: { '@type': 'Answer', text: 'No. StandardCraft resources are designed to complement district curriculum, teacher expertise, and school-approved instructional programs. They help teachers turn publicly available NYS standards into practical classroom materials for planning, practice, intervention, enrichment, and review.' } },
      { '@type': 'Question', name: 'Are these Common Core resources?', acceptedAnswer: { '@type': 'Answer', text: 'No. StandardCraft does not tag any resources as Common Core. ELA and Math resources align to the NYS Next Generation Standards (2017), which replaced Common Core in New York.' } },
      { '@type': 'Question', name: 'Do credits roll over?', acceptedAnswer: { '@type': 'Answer', text: 'Credits do not roll over to the next billing month. Use your credits each month or upgrade to Pro for a larger monthly allocation.' } },
      { '@type': 'Question', name: 'Can I re-download a resource I already purchased?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Once you download a resource, you can re-download it at any time at no additional credit cost.' } },
      { '@type': 'Question', name: 'How do I cancel?', acceptedAnswer: { '@type': 'Answer', text: 'You can cancel anytime from your Account page. Your subscription stays active until the end of the billing period.' } },
    ],
  })} slot="head-schema" />
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-10">
      <div class="section-label mb-4">Simple, credit-based pricing</div>
      <h1 class="text-4xl font-bold mb-4">Start free. Download what you need.</h1>
      <p class="text-[#4a5f63] max-w-xl mx-auto mb-6">
        Browse the full launch library with a free account. Each launch resource costs 1 credit to download, and your signup credit covers one resource.
      </p>
      <!-- Trust chips -->
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-[#415066]">
        {['No student data required', 'Original resources', 'Alignment records included', 'Validated for classroom use', 'Cancel anytime', 'School & district plans available'].map(item => (
          <span class="flex items-center gap-1.5">
            <span class="font-bold" style="color: var(--sc-teal);">✓</span>{item}
          </span>
        ))}
      </div>
    </div>

    <!-- Billing toggle -->
    <div class="flex items-center justify-center mb-10">
      <div class="inline-flex items-center rounded-full border p-1" style="border-color: var(--sc-border); background: #fff;" role="tablist" aria-label="Billing period">
        <button type="button" class="billing-toggle is-active px-5 py-1.5 rounded-full text-sm font-semibold" data-billing="monthly" role="tab" aria-selected="true">Monthly</button>
        <button type="button" class="billing-toggle px-5 py-1.5 rounded-full text-sm font-semibold" data-billing="annual" role="tab" aria-selected="false">
          Annual <span class="text-[#0f766e]">· save up to 40%</span>
        </button>
      </div>
    </div>

    <!-- Plan cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 mt-4 items-stretch">
      {plans.map(p => (
        <div class={`card relative flex flex-col gap-5 ${p.primary ? 'border-t-4 shadow-xl lg:-mt-2 lg:mb-2' : ''}`} style={p.primary ? 'border-top-color: var(--sc-gold);' : ''}>
          {p.badge && <div class="absolute -top-3 left-1/2 -translate-x-1/2 tag tag-amber font-semibold shadow-sm whitespace-nowrap">{p.badge}</div>}
          <div>
            <div class="font-display font-semibold text-xl text-[#172438]">{p.name}</div>
            <div class="flex items-end gap-1 mt-2">
              <span class="font-display text-4xl font-semibold text-[#172438]" data-monthly={p.monthly} data-annual={p.annual}>{p.monthly}</span>
              <span class="text-[#415066] text-sm pb-1.5" data-monthly-note={p.monthlyNote} data-annual-note={p.annualNote}>{p.monthlyNote}</span>
            </div>
            <div class="h-4 mt-1.5 text-xs font-semibold text-[#0f766e]" data-save-annual={p.save}></div>
            <div class="inline-flex items-center gap-1.5 mt-3 rounded-full bg-[#dce8d5] border border-[#cadbc2] px-2.5 py-1 text-xs font-semibold text-[#172438]">
              {p.creditsLabel}
            </div>
          </div>
          <ul class="space-y-2.5 flex-1">
            {p.features.map(f => (
              <li class="flex items-start gap-2 text-sm text-[#415066]">
                <span class="mt-0.5 shrink-0" style="color: var(--sc-teal);">✓</span>
                {f}
              </li>
            ))}
          </ul>
          {p.ctaHref ? (
            <a href={p.ctaHref} class={`${p.primary ? 'btn-primary' : 'btn-outline'} justify-center py-2.5`}>
              {p.cta}
            </a>
          ) : (
            <button
              class={`checkout-btn ${p.primary ? 'btn-primary' : 'btn-outline'} justify-center py-2.5`}
              data-plan={p.ctaPlan}
            >
              {p.cta}
            </button>
          )}
        </div>
      ))}
    </div>

    <!-- Checkout error (replaces alert()) -->
    <div id="checkout-error" class="hidden max-w-2xl mx-auto mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm text-center"></div>

    <!-- School-facing positioning note -->
    <div class="max-w-2xl mx-auto mb-12 text-center">
      <p class="text-sm text-[#4a5f63] leading-relaxed">
        StandardCraft is designed to complement approved curriculum and instructional programs by giving teachers practical, standards-grounded resources they can adapt for classroom use.
        Resources do not replace district curriculum or teacher professional judgment.
      </p>
    </div>

    <!-- Credit cost table -->
    <div class="max-w-2xl mx-auto mb-16">
      <h2 class="text-xl font-bold mb-6 text-center">How credits work</h2>
      <div class="card overflow-hidden p-0">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-[#e4dac8]">
              <th class="text-left px-4 py-3 font-semibold text-[#172438]">Resource Type</th>
              <th class="text-right px-4 py-3 font-semibold text-[#172438]">Credits</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Any launch resource', '1 credit'],
              ['Your free signup account', '1 included credit'],
              ['Re-downloads of claimed resources', '0 additional credits'],
            ].map(([type, cost]) => (
              <tr class="border-t border-[#e4dac8] first:border-0">
                <td class="px-4 py-2.5 text-[#415066]">{type}</td>
                <td class="px-4 py-2.5 text-right font-mono font-semibold text-[#0f766e]">{cost}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-[#415066] mt-3 text-center">The free account lets you browse all {resourceCount} resources and download one with your signup credit.</p>
    </div>

    <!-- FAQ with schema -->
    <div class="max-w-2xl mx-auto">
      <h2 class="text-xl font-bold mb-6 text-center">Common questions</h2>
      <div class="space-y-3" id="pricing-faq">
        {[
          {
            q: 'Is StandardCraft affiliated with NYSED?',
            a: 'No. StandardCraft is an independent resource platform and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. Our resources are built from publicly available standards frameworks and are designed to support classroom planning.',
          },
          {
            q: 'Do I need to enter student data?',
            a: 'No. StandardCraft does not require student personally identifiable information to browse, download, or use teacher resources. StandardCraft is designed for teacher resource access, not student data collection.',
          },
          {
            q: 'Are the resources original?',
            a: 'Yes. StandardCraft resources are created as original instructional supports — not recycled worksheets or copies of marketplace content. Each resource is reviewed for instructional clarity, classroom usability, and standards connection before publication.',
          },
          {
            q: 'Do these resources replace my district curriculum?',
            a: 'No. StandardCraft resources are designed to complement district curriculum, teacher expertise, and school-approved instructional programs. They help teachers turn publicly available NYS standards into practical classroom materials for planning, practice, intervention, enrichment, and review.',
          },
          {
            q: 'Are these Common Core resources?',
            a: 'No. StandardCraft does not tag any resources as Common Core. ELA and Math resources align to the NYS Next Generation Standards (2017), which replaced Common Core in New York.',
          },
          {
            q: 'Do credits roll over?',
            a: 'Credits do not roll over to the next billing month. Use your credits each month or upgrade to Pro for a larger monthly allocation.',
          },
          {
            q: 'Can I re-download a resource I already purchased?',
            a: 'Yes. Once you download a resource, you can re-download it at any time at no additional credit cost.',
          },
          {
            q: 'How do I cancel?',
            a: 'You can cancel anytime from your Account page. Your subscription stays active until the end of the billing period.',
          },
        ].map(faq => (
          <details class="group card p-0 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-semibold text-sm text-[#172438] hover:text-[#376b9b] transition-colors">
              {faq.q}
              <span class="shrink-0 transition-transform group-open:rotate-45 text-lg leading-none font-bold" style="color: var(--sc-gold);">+</span>
            </summary>
            <div class="px-5 pb-5 text-sm text-[#415066] leading-relaxed border-t border-[#e4dac8] pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-12 text-center text-sm text-[#4a5f63]">
      Questions about school or district pricing?
      <a href="/school-inquiry" class="text-[#376b9b] hover:underline ml-1">Contact us →</a>
    </div>
  </section>
</Layout>

<script>
  import { createSupabaseBrowserClient } from '../lib/supabase';

  // Monthly / annual billing toggle
  let billing: 'monthly' | 'annual' = 'monthly';
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.billing-toggle'));

  function setBilling(mode: 'monthly' | 'annual') {
    billing = mode;
    document.querySelectorAll<HTMLElement>('[data-monthly]').forEach((el) => {
      el.textContent = el.dataset[mode] ?? el.textContent;
    });
    document.querySelectorAll<HTMLElement>('[data-monthly-note]').forEach((el) => {
      el.textContent = el.dataset[`${mode}Note`] ?? el.textContent;
    });
    document.querySelectorAll<HTMLElement>('[data-save-annual]').forEach((el) => {
      el.textContent = mode === 'annual' ? (el.dataset.saveAnnual ?? '') : '';
    });
    toggles.forEach((t) => {
      const on = t.dataset.billing === mode;
      t.classList.toggle('is-active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
  }
  toggles.forEach((t) => t.addEventListener('click', () => setBilling(t.dataset.billing as 'monthly' | 'annual')));

  // Shared checkout error banner (shown below plan cards)
  let checkoutErrorEl = document.getElementById('checkout-error') as HTMLDivElement | null;
  function showCheckoutError(msg: string) {
    if (!checkoutErrorEl) return;
    checkoutErrorEl.textContent = msg;
    checkoutErrorEl.classList.remove('hidden');
    checkoutErrorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    setTimeout(() => checkoutErrorEl!.classList.add('hidden'), 8000);
  }

  // Returning from an abandoned Stripe checkout — reassure, then clean the URL
  if (new URLSearchParams(window.location.search).get('checkout') === 'cancelled') {
    showCheckoutError('Checkout was cancelled — you have not been charged. Your plan is here whenever you are ready.');
    history.replaceState(null, '', window.location.pathname);
  }

  document.querySelectorAll('.checkout-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const plan = btn.getAttribute('data-plan')!;
      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = 'Redirecting…';
      checkoutErrorEl?.classList.add('hidden');

      const supabase = createSupabaseBrowserClient();
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) {
        window.location.href = `/sign-in?redirect=/pricing`;
        return;
      }

      (window as any).plausible?.('Begin Checkout', { props: { plan, billing } });

      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan, billing }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          showCheckoutError(data.error || 'Could not start checkout. Please try again or contact support.');
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = `Start ${plan.charAt(0).toUpperCase() + plan.slice(1)}`;
        }
      } catch {
        showCheckoutError('Network error. Please check your connection and try again.');
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = `Start ${plan.charAt(0).toUpperCase() + plan.slice(1)}`;
      }
    });
  });
</script>
