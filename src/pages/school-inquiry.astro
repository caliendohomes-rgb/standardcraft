---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Schools & Districts — StandardCraft"
  description="Request a StandardCraft school or district pricing quote. Pooled credits, admin dashboard, Ed Law §2-d data agreement, and invoice billing available."
>
  <section class="max-w-2xl mx-auto px-4 py-20">
    <div class="section-label mb-3">School & District Pricing</div>
    <h1 class="text-3xl font-bold mb-3">Bring StandardCraft to your school or district</h1>
    <p class="text-[#4a5f63] mb-4">
      School plans start at $249/month and include pooled credits, a multi-teacher admin panel, and an Ed Law §2-d FERPA-compliant data agreement.
    </p>

    <!-- Ed Law §2-d notice -->
    <div class="card border-teal-800/50 bg-teal-950/10 mb-8 text-sm text-[#4a5f63] space-y-2">
      <div class="font-semibold text-[#e8f0f0]">Data Privacy — Ed Law §2-d (8 NYCRR Part 121)</div>
      <p>StandardCraft operates as a third-party contractor when serving school or district accounts. Upon entering a School plan agreement, we will execute a standard Ed Law §2-d data sharing agreement (DSA) that governs how educator and student data may be used, stored, and disclosed.</p>
      <p>Educator personally identifiable information (PII) collected under a school contract is used solely to provide the contracted services. It is not sold, shared for commercial purposes, or used for targeted advertising.</p>
      <p class="text-xs">This notice applies to School plan accounts only. Individual educator (non-institutional) accounts are governed by our Privacy Policy.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
      {[
        { icon: '🏫', title: 'Pooled credits', desc: 'Admin assigns credits across teacher accounts' },
        { icon: '📊', title: 'Admin dashboard', desc: 'Usage reports, download history, roster management' },
        { icon: '📄', title: 'Invoice / PO billing', desc: 'Net-30 invoicing available for district accounts' },
      ].map(f => (
        <div class="card text-center">
          <div class="text-2xl mb-2">{f.icon}</div>
          <div class="font-semibold text-sm mb-1">{f.title}</div>
          <div class="text-xs text-[#4a5f63]">{f.desc}</div>
        </div>
      ))}
    </div>

    <div id="success-msg" class="hidden mb-4 p-4 rounded-lg bg-teal-950/60 border border-teal-700 text-teal-200 text-sm">
      Thank you — we'll reach out within 1 business day.
    </div>
    <div id="error-msg" class="hidden mb-4 p-3 rounded-lg bg-red-950/60 border border-red-800 text-red-300 text-sm"></div>

    <form id="inquiry-form" class="space-y-4" novalidate>
      <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true"
        class="absolute opacity-0 pointer-events-none w-0 h-0" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Full name <span class="text-red-400">*</span></label>
          <input type="text" name="full_name" required
            class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Role / Title</label>
          <input type="text" name="role_title" placeholder="e.g. Curriculum Director"
            class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Email <span class="text-red-400">*</span></label>
        <input type="email" name="email" required
          class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Phone</label>
        <input type="tel" name="phone"
          class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">School or District name</label>
        <input type="text" name="school_or_district"
          class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Estimated number of teachers</label>
        <select name="estimated_teachers"
          class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm">
          <option value="">Select a range</option>
          <option value="1-5">1–5 teachers</option>
          <option value="6-20">6–20 teachers</option>
          <option value="21-50">21–50 teachers</option>
          <option value="51-100">51–100 teachers</option>
          <option value="100+">100+ teachers</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium mb-1.5">Tell us about your needs</label>
        <textarea name="message" rows={4}
          placeholder="Grade levels, subjects, goals, timeline, questions about §2-d compliance…"
          class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm resize-none"></textarea>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary w-full py-3">Submit inquiry →</button>
    </form>
  </section>
</Layout>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const fd = new FormData(form);
    const payload: Record<string, any> = {};
    fd.forEach((v, k) => { payload[k] = typeof v === 'string' ? v.trim() : v; });

    try {
      const res = await fetch('/api/school-inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        successMsg.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg.textContent = data.error || 'Submission failed. Please try again.';
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.textContent = 'Network error. Please try again.';
      errorMsg.classList.remove('hidden');
    }
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit inquiry →';
  });
</script>
