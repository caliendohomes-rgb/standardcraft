---
export const prerender = false;

import { createSupabaseServerClient, createSupabaseAdmin } from '../lib/supabase-server';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/signin?redirect=/free-resource-library');
}

const admin = createSupabaseAdmin();

const [creditsResult, downloadsResult, allResources] = await Promise.all([
  admin.from('credits').select('balance').eq('user_id', user.id).single(),
  admin.from('downloads').select('resource_slug').eq('user_id', user.id),
  getCollection('resources'),
]);

const balance: number = creditsResult.data?.balance ?? 0;
const downloadedSlugs = new Set((downloadsResult.data ?? []).map((d: any) => d.resource_slug));

const CREDIT_COST: Record<string, number> = {
  'Lesson Plan': 2,
  'Co-Teaching Frame': 2,
  'Task Card Set': 2,
  'CDOS Transition Material': 2,
  'IEP Goal-Support Resource': 3,
  'SDI Planning Frame': 2,
  'default': 1,
};

function creditCost(type: string): number {
  return CREDIT_COST[type] ?? CREDIT_COST['default'];
}
---

<Layout
  title="Free Resource Library — StandardCraft"
  description="Access your StandardCraft resources. NYS-aligned lesson plans, worksheets, SDI blocks, and MLL scaffolds."
  noIndex={true}
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-10">
      <div>
        <div class="section-label mb-1">Your Library</div>
        <h1 class="text-3xl font-bold">50 NYS-Aligned Resources</h1>
      </div>
      <div class="flex items-center gap-4">
        <div class="card py-2 px-4 text-center min-w-[120px]">
          <div class="text-2xl font-bold text-teal-400" id="credit-balance">{balance}</div>
          <div class="text-xs text-[#4a5f63]">credits remaining</div>
        </div>
        {balance === 0 && (
          <a href="/pricing" class="btn-primary text-sm py-2 px-4">Get more credits →</a>
        )}
        {balance > 0 && balance <= 2 && (
          <a href="/pricing" class="btn-outline text-sm py-2 px-4">Upgrade plan</a>
        )}
      </div>
    </div>

    {balance === 0 && (
      <div class="mb-8 p-4 rounded-xl bg-amber-950/40 border border-amber-800/60 text-amber-300 text-sm flex items-start gap-3">
        <span class="text-lg">⚠️</span>
        <div>
          <strong>You've used your free trial credit.</strong>
          <span class="text-amber-400/80"> Upgrade to Classroom ($29/mo · 8 credits) or Pro ($69/mo · 20 credits) to download more resources.</span>
          <a href="/pricing" class="ml-2 text-amber-300 underline hover:text-amber-200">View plans →</a>
        </div>
      </div>
    )}

    <!-- Resource grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {allResources.map(resource => {
        const cost = creditCost(resource.data.resource_type);
        const alreadyDownloaded = downloadedSlugs.has(resource.slug);
        const canDownload = alreadyDownloaded || balance >= cost;

        return (
          <div class="card flex flex-col gap-3">
            <div class="flex flex-wrap gap-2">
              <span class="tag tag-teal">{resource.data.subject}</span>
              <span class="tag tag-gray">Grade {resource.data.grade}</span>
              {alreadyDownloaded && <span class="tag bg-teal-900/60 text-teal-300 border-teal-700/50">Downloaded</span>}
            </div>
            <h3 class="font-semibold text-sm leading-snug flex-1">{resource.data.title}</h3>
            <div class="flex items-center gap-2 text-xs">
              <span class="font-mono text-teal-400 bg-teal-900/30 px-2 py-0.5 rounded border border-teal-800/50">
                {resource.data.standards[0]?.code}
              </span>
              <span class="text-[#4a5f63]">{resource.data.resource_type}</span>
            </div>
            <div class="flex items-center justify-between mt-auto pt-2 border-t border-[#1e2a2d]">
              <span class="text-xs text-[#4a5f63]">
                {alreadyDownloaded ? 'Free re-download' : `${cost} credit${cost === 1 ? '' : 's'}`}
              </span>
              <button
                class={`download-btn text-sm py-1.5 px-3 rounded-lg font-medium transition-colors ${canDownload ? 'bg-teal-700 hover:bg-teal-600 text-white' : 'bg-[#1e2a2d] text-[#4a5f63] cursor-not-allowed'}`}
                data-slug={resource.slug}
                data-cost={cost}
                data-title={resource.data.title}
                disabled={!canDownload}
              >
                {alreadyDownloaded ? 'Download again' : canDownload ? 'Download' : 'Need credits'}
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Bottom upgrade banner -->
    <div class="mt-16 card border-teal-800/50 bg-teal-950/20 p-8 text-center">
      <h2 class="text-2xl font-bold mb-3">Ready for more?</h2>
      <p class="text-[#4a5f63] mb-6">Classroom plan gives you 8 credits/month. Pro gives you 20. All resources, all frameworks.</p>
      <a href="/pricing" class="btn-primary py-3 px-8">View plans →</a>
    </div>
  </section>

  <!-- Download toast -->
  <div id="download-toast" class="hidden fixed bottom-6 right-6 z-50 p-4 rounded-xl bg-teal-900 border border-teal-700 text-teal-100 text-sm shadow-2xl max-w-xs">
    <div id="toast-msg">Preparing download…</div>
  </div>
</Layout>

<script>
  import { createSupabaseBrowserClient } from '../lib/supabase';

  const toast = document.getElementById('download-toast') as HTMLDivElement;
  const toastMsg = document.getElementById('toast-msg') as HTMLDivElement;
  const balanceEl = document.getElementById('credit-balance') as HTMLDivElement;

  function showToast(msg: string, isError = false) {
    toastMsg.textContent = msg;
    toast.className = `fixed bottom-6 right-6 z-50 p-4 rounded-xl border text-sm shadow-2xl max-w-xs ${
      isError ? 'bg-red-950 border-red-800 text-red-200' : 'bg-teal-900 border-teal-700 text-teal-100'
    }`;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 4000);
  }

  document.querySelectorAll('.download-btn:not([disabled])').forEach(btn => {
    btn.addEventListener('click', async () => {
      const slug = btn.getAttribute('data-slug')!;
      const cost = parseInt(btn.getAttribute('data-cost')!, 10);
      const title = btn.getAttribute('data-title')!;

      (btn as HTMLButtonElement).disabled = true;
      (btn as HTMLButtonElement).textContent = 'Downloading…';
      showToast('Preparing download…');

      try {
        const res = await fetch('/api/download', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ resource_slug: slug }),
        });

        const data = await res.json();

        if (!res.ok) {
          if (data.code === 'INSUFFICIENT_CREDITS') {
            showToast('Not enough credits. Upgrade your plan to continue.', true);
          } else {
            showToast(data.error || 'Download failed.', true);
          }
          (btn as HTMLButtonElement).disabled = false;
          (btn as HTMLButtonElement).textContent = 'Download';
          return;
        }

        // Update credit display
        if (!data.redownload && balanceEl) {
          const current = parseInt(balanceEl.textContent || '0', 10);
          balanceEl.textContent = String(Math.max(0, current - cost));
        }

        // Trigger download
        const a = document.createElement('a');
        a.href = data.url;
        a.download = `${slug}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

        showToast(`"${title}" is downloading.`);
        (btn as HTMLButtonElement).textContent = 'Download again';
        btn.setAttribute('data-redownload', 'true');
      } catch {
        showToast('Network error. Please try again.', true);
        (btn as HTMLButtonElement).disabled = false;
        (btn as HTMLButtonElement).textContent = 'Download';
      }
    });
  });
</script>
