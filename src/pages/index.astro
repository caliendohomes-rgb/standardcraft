---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import FaqSection from '../components/FaqSection.astro';

const allResources = await getCollection('resources');
const featuredResources = allResources.slice(0, 3);

const faqItems = [
  {
    q: 'Is StandardCraft affiliated with NYSED?',
    a: 'No. StandardCraft is independent from NYSED. Resources are built from publicly available New York State standards frameworks and include transparent alignment notes.',
  },
  {
    q: 'Does StandardCraft replace district curriculum?',
    a: 'No. StandardCraft supports classroom planning and implementation. District curriculum, local requirements, and teacher professional judgment still come first.',
  },
  {
    q: 'Do teachers need to enter student data?',
    a: 'No student data is required to create a free account, browse resources, or download with a signup credit.',
  },
  {
    q: 'What are alignment notes?',
    a: 'Alignment notes explain the standards connection in teacher-friendly language so educators can judge fit before using a resource.',
  },
  {
    q: 'Are the resources original?',
    a: 'Yes. The launch library contains original StandardCraft resources created for classroom use, not copied marketplace materials.',
  },
  {
    q: 'What does the free account include?',
    a: 'A free account lets you browse 50 resources and download one resource with your signup credit.',
  },
  {
    q: 'Why can I browse 50 resources but download one free?',
    a: 'The free signup credit lets you try one resource before choosing whether to upgrade for more downloads.',
  },
];
---

<Layout
  title="StandardCraft | NYS-Aligned Classroom Resources"
  description="Browse 50 original New York classroom resources and download one free with your signup credit. No payment required."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-12">
    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-12 items-center">
      <div>
        <div class="section-label mb-5">Built for New York classrooms</div>
        <h1 class="text-5xl sm:text-6xl font-bold leading-[1.05] tracking-tight mb-6 text-[#172438]">
          Warm, practical resources for standards-aligned teaching days.
        </h1>
        <p class="text-xl text-[#415066] max-w-2xl mb-8">
          Browse 50 resources and download one free with your signup credit. StandardCraft helps teachers move from standards to usable classroom materials without the heavy lift.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/claim-free" class="btn-primary text-base py-3.5 px-8">Start free</a>
          <a href="/resources" class="btn-outline text-base py-3.5 px-8">Preview the library</a>
        </div>
        <p class="mt-4 text-sm font-semibold text-[#415066]">
          Browse 50 resources. Download one free with your signup credit. No payment required.
        </p>
      </div>

      <div class="card border-t-4" style="border-top-color: var(--sc-gold);">
        <div class="section-label mb-3">Teacher planning card</div>
        <h2 class="text-2xl font-bold mb-2 text-[#172438]">Grade 3-5 ELA</h2>
        <p class="font-semibold text-[#415066] mb-4">Main Idea Evidence Ladder</p>
        <ul class="space-y-3 text-sm text-[#415066]">
          <li>Alignment note included</li>
          <li>Classroom use case included</li>
          <li>Ready-to-download file</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-y" style="border-color: var(--sc-border); background: rgba(255,255,255,0.62);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 grid sm:grid-cols-2 lg:grid-cols-5 gap-3 text-center text-sm font-bold text-[#415066]">
      <span>Original resources</span>
      <span>Built from publicly available NYS standards</span>
      <span>Alignment notes included</span>
      <span>No student data required</span>
      <span>Independent from NYSED</span>
    </div>
  </section>

  <section id="how-it-works" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="section-label mb-4">How it works</div>
    <h2 class="text-3xl font-bold mb-8 text-[#172438]">Create an account, browse widely, download intentionally.</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        'Create a free account',
        'Browse 50 NYS-aligned resources',
        'Download one with your free credit',
        'Upgrade when you need more',
      ].map((step, index) => (
        <div class="card">
          <div class="inline-flex w-9 h-9 rounded-full items-center justify-center font-bold mb-4" style="background: var(--sc-gold-soft); color: var(--sc-navy);">{index + 1}</div>
          <h3 class="font-bold text-[#172438]">{step}</h3>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20" style="background: rgba(220, 232, 213, 0.38);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
        <div>
          <div class="section-label mb-3">Sample resources</div>
          <h2 class="text-3xl font-bold text-[#172438]">Designed to feel useful before the bell rings.</h2>
        </div>
        <a href="/claim-free" class="btn-primary">Claim your free resource</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {featuredResources.map(resource => (
          <ResourceCard resource={resource} />
        ))}
      </div>
    </div>
  </section>

  <section id="why-us" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <div class="section-label mb-4">Why teachers trust StandardCraft</div>
        <h2 class="text-3xl font-bold mb-4 text-[#172438]">Clear alignment without pretending to be your curriculum.</h2>
        <p class="text-[#415066]">
          Each resource includes a plain-language alignment note, a practical classroom use case, and preview content so teachers can decide quickly whether it fits the lesson in front of them.
        </p>
      </div>
      <div class="grid gap-4">
        <div class="card"><strong>Teacher-centered:</strong> written for real planning constraints and mixed-readiness classrooms.</div>
        <div class="card"><strong>Transparent:</strong> standards labels and notes are visible before download.</div>
        <div class="card"><strong>Respectful:</strong> no student data is required to browse or claim the free credit.</div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="section-label mb-4">Built for New York classrooms</div>
    <h2 class="text-3xl font-bold mb-4 text-[#172438]">Support for daily planning, not a replacement for teacher judgment.</h2>
    <p class="text-[#415066]">
      StandardCraft resources help teachers interpret publicly available standards, prepare classroom-ready materials, and document alignment. They are designed to complement district curriculum and local instructional decisions.
    </p>
  </section>

  <FaqSection heading="Questions teachers ask about StandardCraft" items={faqItems} />

  <section class="max-w-3xl mx-auto px-4 text-center py-20">
    <div class="section-label mb-4">Start today</div>
    <h2 class="text-4xl font-bold mb-5 text-[#172438]">Browse 50 resources. Download one free.</h2>
    <p class="text-[#415066] mb-8">No payment required. No student data required. Upgrade only when you need more downloads.</p>
    <a href="/claim-free" class="btn-primary text-lg py-4 px-10">Start free</a>
  </section>
</Layout>
