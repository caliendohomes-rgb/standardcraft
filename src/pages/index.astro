---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import ResourceCarousel from '../components/ResourceCarousel.astro';
import FaqSection from '../components/FaqSection.astro';

const allResources = await getCollection('resources');
const featuredResources = allResources.slice(0, 3);

// One representative resource per subject area for the hero carousel.
const carouselSubjects = [
  'Math', 'ELA', 'Science', 'Social Studies',
  'Computer Science & Digital Fluency', 'World Languages',
  'Arts', 'Cross-Content SDI & IEP Support',
];
const carouselResources = carouselSubjects
  .map((s) => allResources.find((r) => r.data.subject === s))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));

const faqItems = [
  {
    q: 'Is StandardCraft affiliated with NYSED?',
    a: 'No. StandardCraft is independent from NYSED. Resources are built from publicly available New York State standards frameworks and include transparent alignment notes.',
  },
  {
    q: 'Does StandardCraft replace district curriculum?',
    a: 'No. StandardCraft supports classroom planning and implementation. District curriculum, local requirements, and teacher professional judgment still come first.',
  },
  {
    q: 'Do teachers need to enter student data?',
    a: 'No student data is required to create a free account, browse resources, or download with a signup credit.',
  },
  {
    q: 'What are alignment notes?',
    a: 'Alignment notes explain the standards connection in teacher-friendly language so educators can judge fit before using a resource.',
  },
  {
    q: 'Are the resources original?',
    a: 'Yes. The launch library contains original StandardCraft resources created for classroom use, not copied marketplace materials.',
  },
  {
    q: 'What does the free account include?',
    a: 'A free account lets you browse 50 resources and download one resource with your signup credit.',
  },
  {
    q: 'Why can I browse 50 resources but download one free?',
    a: 'The free signup credit lets you try one resource before choosing whether to upgrade for more downloads.',
  },
];
---

<Layout
  title="StandardCraft | NYS-Aligned Classroom Resources"
  description="Browse 50 original New York classroom resources and download one free with your signup credit. No payment required."
>
  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-10 lg:gap-14 items-start">

      <!-- LEFT: Headline + copy + CTAs -->
      <div class="pt-2">
        <div class="section-label mb-4">Built for New York classrooms · NYS Next Generation aligned</div>
        <h1 class="text-4xl sm:text-5xl lg:text-[3.35rem] font-semibold leading-[1.12] mb-5 text-[#172438]" style="max-width: 22ch;">
          NYS-aligned lessons and worksheets — ready to use tomorrow and defend to your administrator.
        </h1>
        <p class="text-base sm:text-lg text-[#415066] leading-relaxed mb-7" style="max-width: 48ch;">
          Every resource is built from real NYS standards — Next Generation, NYSSLS, NYSESLAT, and CDOS — with the exact standard code, an alignment record, SDI supports, and MLL/ELL scaffolds. No invented codes. No student data required.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mb-5">
          <a href="/claim-free" class="btn-primary text-base py-3.5 px-7">Claim my free resource →</a>
          <a href="/resources" class="btn-outline text-base py-3.5 px-7">Browse all 50 resources</a>
        </div>
        <p class="text-xs text-[#415066] flex flex-wrap items-center gap-x-4 gap-y-1">
          <span class="flex items-center gap-1.5"><span class="text-[#4f9a91] font-bold">✓</span>No credit card required</span>
          <span class="flex items-center gap-1.5"><span class="text-[#4f9a91] font-bold">✓</span>50 resources to browse free</span>
          <span class="flex items-center gap-1.5"><span class="text-[#4f9a91] font-bold">✓</span>1 free download with signup</span>
        </p>
      </div>

      <!-- RIGHT: Carousel in a subtle framed well -->
      <div class="lg:mt-1">
        <div class="section-label mb-3 flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full" style="background: var(--sc-gold);"></span>
          Live previews from the library
        </div>
        <div class="rounded-2xl p-3 sm:p-4" style="background: rgba(220,232,213,0.28); border: 1px solid var(--sc-border);">
          <ResourceCarousel resources={carouselResources} />
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-y" style="border-color: var(--sc-border); background: rgba(255,255,255,0.7);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-xs font-semibold text-[#415066]">
        {[
          'Original resources',
          'Publicly available NYS standards only',
          'Alignment records included',
          'No student data required',
          'Independent from NYSED',
        ].map(item => (
          <span class="flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full shrink-0" style="background: var(--sc-gold);"></span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT'S BUILT -->
  <section id="how-its-built" class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 scroll-mt-20">
    <div class="max-w-2xl mb-8">
      <div class="section-label mb-3">How every StandardCraft resource is built</div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-[#172438] mb-3">Three layers between a standard and your classroom.</h2>
      <p class="text-[#415066] leading-relaxed">Not a generic prompt. Every resource moves through a defined pathway — and we're precise about exactly where a human is involved.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="card">
        <div class="inline-flex w-8 h-8 rounded-full items-center justify-center text-sm font-bold mb-4 font-mono" style="background: var(--sc-sage); color: var(--sc-navy);">1</div>
        <h3 class="font-display font-semibold text-[17px] mb-2 text-[#172438]">Grounded in real NYS frameworks</h3>
        <p class="text-sm text-[#415066] leading-relaxed">Built from publicly available NY standards — NYS Next Generation Learning Standards, NYSSLS, NYSESLAT, and CDOS. Standard codes sourced from official NYSED documents. Never invented.</p>
      </div>
      <div class="card">
        <div class="inline-flex w-8 h-8 rounded-full items-center justify-center text-sm font-bold mb-4 font-mono" style="background: var(--sc-sage); color: var(--sc-navy);">2</div>
        <h3 class="font-display font-semibold text-[17px] mb-2 text-[#172438]">Automated validation + founder oversight</h3>
        <p class="text-sm text-[#415066] leading-relaxed">Every resource passes structural and standards-alignment checks, with founder review before publication to the library.</p>
      </div>
      <div class="card border-t-4" style="border-top-color: var(--sc-gold);">
        <div class="inline-flex w-8 h-8 rounded-full items-center justify-center text-sm font-bold mb-4 font-mono" style="background: var(--sc-gold-soft); color: var(--sc-navy);">3</div>
        <h3 class="font-display font-semibold text-[17px] mb-2 text-[#172438]">Human educator review — Math pilot</h3>
        <p class="text-sm text-[#415066] leading-relaxed">A NYS-certified math teacher reviews Mathematics resources. This is <strong class="text-[#172438]">currently a Mathematics-only pilot</strong>; all other subjects use grounded generation, validation, and founder oversight.</p>
      </div>
    </div>
    <p class="text-[11px] text-[#415066] mt-5 max-w-3xl leading-relaxed">
      StandardCraft is independent and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. IEP goal suggestions are teacher-reference material and do not constitute legal IEP documents.
    </p>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works" class="reveal py-14" style="background: rgba(220, 232, 213, 0.22);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-label mb-3">How it works</div>
      <h2 class="text-3xl font-bold mb-7 text-[#172438]">Browse widely. Download intentionally.</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { n: 1, step: 'Create a free account', detail: 'No credit card required.' },
          { n: 2, step: 'Browse 50 NYS resources', detail: 'Preview every resource before downloading.' },
          { n: 3, step: 'Download one free', detail: 'Your signup credit covers one resource.' },
          { n: 4, step: 'Upgrade when ready', detail: '8 or 20 credits per month on paid plans.' },
        ].map(s => (
          <div class="card">
            <div class="inline-flex w-8 h-8 rounded-full items-center justify-center text-sm font-bold mb-3" style="background: var(--sc-gold-soft); color: var(--sc-navy);">{s.n}</div>
            <h3 class="font-semibold text-[#172438] mb-1">{s.step}</h3>
            <p class="text-xs text-[#415066]">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SAMPLE RESOURCES -->
  <section class="reveal py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7">
        <div>
          <div class="section-label mb-2">Sample resources</div>
          <h2 class="text-3xl font-bold text-[#172438]">Useful before the bell rings.</h2>
        </div>
        <a href="/claim-free" class="btn-primary shrink-0">Claim your free resource →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {featuredResources.map(resource => (
          <ResourceCard resource={resource} />
        ))}
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section id="why-us" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div>
        <div class="section-label mb-3">Why teachers trust StandardCraft</div>
        <h2 class="text-3xl font-bold mb-4 text-[#172438]">Clear alignment. No pretense about replacing your curriculum.</h2>
        <p class="text-[#415066] leading-relaxed">
          Each resource includes a plain-language alignment note, a practical classroom use case, and preview content — so teachers can judge fit in under a minute.
        </p>
        <a href="/resources" class="btn-outline mt-6 inline-flex">Browse all resources →</a>
      </div>
      <div class="grid gap-3">
        {[
          { label: 'Teacher-centered', body: 'Written for real planning constraints and mixed-readiness classrooms.' },
          { label: 'Transparent', body: 'Standards labels and alignment notes are visible before you download.' },
          { label: 'Respectful of your autonomy', body: 'No student data required to browse or claim your free credit.' },
        ].map(c => (
          <div class="card">
            <strong class="text-[#172438] text-sm">{c.label}</strong>
            <p class="text-sm text-[#415066] mt-1">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI vs StandardCraft comparison -->
  <section class="reveal py-14" style="background: rgba(220, 232, 213, 0.28);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-label mb-3">Why not a generic AI tool?</div>
      <h2 class="text-3xl sm:text-4xl font-semibold text-[#172438] mb-7 max-w-2xl">A prompt gives you a guess. StandardCraft gives you a record.</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="card">
          <div class="font-display font-semibold text-[17px] text-[#172438] mb-4">A generic AI worksheet</div>
          <ul class="space-y-2.5 text-sm text-[#415066]">
            {[
              'Standard codes that may be wrong or invented',
              'Not NYS-specific (often outdated Common Core)',
              'No SDI adaptations or NYSESLAT-leveled scaffolds',
              'Nothing to show an administrator or IEP team',
              'You verify every claim yourself',
            ].map(item => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 shrink-0 font-bold" style="color: #b08968;">–</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="card border-t-4" style="border-top-color: var(--sc-gold);">
          <div class="font-display font-semibold text-[17px] text-[#172438] mb-4">A StandardCraft resource</div>
          <ul class="space-y-2.5 text-sm text-[#415066]">
            {[
              'The exact NYS Next Gen / NYSSLS code, sourced from NYSED',
              'An alignment record you can hand to an evaluator',
              'SDI adaptations + MLL/ELL scaffolds by proficiency level',
              'Original content, validated before publication',
              'Built only for New York classrooms',
            ].map(item => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 shrink-0 font-bold" style="color: var(--sc-teal);">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FaqSection heading="Questions teachers ask about StandardCraft" items={faqItems} />

  <!-- FINAL CTA -->
  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="section-label mb-3">Start today</div>
      <h2 class="text-4xl font-semibold mb-4 text-[#172438]">One free resource, no credit card.</h2>
      <p class="text-[#415066] mb-8 leading-relaxed">Browse all 50 NYS resources and download one with your signup credit. Upgrade only when you need more downloads.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/claim-free" class="btn-primary text-base py-3.5 px-8">Claim my free resource →</a>
        <a href="/school-inquiry" class="btn-outline text-base py-3.5 px-8">Request a school quote</a>
      </div>
    </div>
  </section>
</Layout>
