---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TrustModule from '../components/TrustModule.astro';
import FaqSection from '../components/FaqSection.astro';

const allResources = await getCollection('resources');
const ssResources = allResources.filter(r =>
  r.data.subject === 'Social Studies'
);

const faqItems = [
  {
    q: 'Which Social Studies framework do these resources use?',
    a: 'Resources are aligned to the NYS K-12 Social Studies Framework (2014, updated), which organizes content around Key Ideas, Conceptual Understandings, and Content Specifications across Grades K–12. All standard codes are cited from the publicly available framework document.',
  },
  {
    q: 'Are Social Studies resources original?',
    a: 'Yes. All resources are created as original instructional supports — not copied from existing curriculum packages or marketplace materials. Each is reviewed for instructional clarity and alignment to the relevant Social Studies Key Idea and Content Specification.',
  },
  {
    q: 'Are Practices included?',
    a: 'Yes. Resources incorporate the NYS Social Studies Practices — chronological reasoning, comparison, contextualization, gathering and using evidence, geographic reasoning, civic participation, and more — integrated into the lesson design where appropriate.',
  },
  {
    q: 'Is StandardCraft affiliated with NYSED?',
    a: 'No. StandardCraft is an independent resource platform and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. Resources are built from the publicly available NYS Social Studies Framework.',
  },
  {
    q: 'Do Social Studies resources include literacy supports?',
    a: 'Yes. Social Studies resources include MLL/ELL scaffolds (NYSESLAT-tiered) and literacy-in-content-area supports where relevant, including academic vocabulary, sentence frames, and text-based evidence structures.',
  },
  {
    q: 'Do I need student data to access Social Studies resources?',
    a: 'No. Teachers browse and download Social Studies resources without entering student personally identifiable information.',
  },
];
---

<Layout
  title="NYS Social Studies Resources — K-12 Framework | StandardCraft"
  description="Original, educator-reviewed NYS Social Studies resources aligned to the NYS K-12 Social Studies Framework. Key Ideas, Conceptual Understandings, and Practices. Independent from NYSED."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="max-w-3xl">
      <div class="section-label mb-4">NYS Social Studies Resources</div>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
        Social Studies resources built from the NYS K-12 Social Studies Framework
      </h1>
      <p class="text-lg text-[#4a5f63] mb-4 leading-relaxed">
        Original, educator-reviewed Social Studies lesson plans and classroom resources grounded in the NYS K-12 Social Studies Framework —
        organized around Key Ideas, Conceptual Understandings, and Content Specifications.
        Includes alignment notes, Social Studies Practices, SDI blocks, and MLL/ELL scaffolds.
      </p>
      <p class="text-sm text-[#3a5055] mb-8">
        Educator-reviewed · Original content · Alignment notes included · Independent from NYSED
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/claim-free" class="btn-primary py-3 px-8">Get 1 free Social Studies resource →</a>
        <a href="/resources" class="btn-outline py-3 px-8">Browse all resources</a>
      </div>
    </div>
  </section>

  <section class="border-y py-8" style="border-color: var(--sc-border); background: var(--sc-sage);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {[
          { value: `${ssResources.length}+`, label: 'Social Studies resources' },
          { value: 'K–12', label: 'Grade bands covered' },
          { value: '2014', label: 'NYS SS Framework' },
          { value: '100%', label: 'Original content' },
        ].map(s => (
          <div class="text-center">
            <div class="text-2xl font-bold text-[#172438]">{s.value}</div>
            <div class="text-xs text-[#415066] mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t py-16" style="border-color: var(--sc-border);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-label mb-4">Framework structure</div>
      <h2 class="text-2xl font-bold mb-8">How StandardCraft Social Studies resources are organized</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { label: 'Key Ideas', desc: 'Each resource is grounded in one or more Key Ideas from the NYS Social Studies Framework — the central organizing concepts for each grade band.' },
          { label: 'Conceptual Understandings', desc: 'Alignment notes include the Conceptual Understanding the resource addresses — the specific interpretive statement that the Key Idea produces.' },
          { label: 'Content Specifications', desc: 'Resources connect to specific Content Specifications — the factual, conceptual, and analytical content students are expected to engage with.' },
        ].map(item => (
          <div class="card">
            <div class="font-semibold text-sm mb-2 text-[#0f766e]">{item.label}</div>
            <p class="text-xs text-[#4a5f63] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {ssResources.length > 0 && (
    <section class="border-t py-16" style="border-color: var(--sc-border); background: #f7f4ee;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-bold text-[#172438]">Available Social Studies resources</h2>
          <a href="/resources" class="text-sm text-[#376b9b] hover:underline">Browse all →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {ssResources.map(r => (
            <a href={`/resources/${r.slug}`} class="card group hover:border-[#b5ceae] transition-colors no-underline cursor-pointer">
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="tag tag-gray">Social Studies</span>
                <span class="tag tag-gray">Grade {r.data.grade}</span>
                <span class="tag tag-gray">{r.data.resource_type}</span>
              </div>
              <h3 class="font-semibold text-sm leading-snug mb-2 text-[#172438] group-hover:text-[#376b9b] transition-colors">{r.data.title}</h3>
              <div class="flex items-center gap-2 text-xs">
                <span class="font-mono text-xs text-[#0f766e] bg-[#dce8d5] px-2 py-0.5 rounded border border-[#cadbc2]">
                  {r.data.standards[0]?.code}
                </span>
                <span class="text-[#415066]">NYS SS Framework</span>
              </div>
              <p class="text-[11px] text-[#415066] mt-3 pt-2 border-t" style="border-color: var(--sc-border);">
                Key Idea + Practices · Alignment note included · Original resource
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <TrustModule heading="Built for trust, not just search." subjectContext="Social Studies" />

  <FaqSection
    heading="Questions about StandardCraft Social Studies resources"
    items={faqItems}
    id="faq-ss"
  />
</Layout>
