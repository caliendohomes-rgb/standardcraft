---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(r => ({ params: { slug: r.slug }, props: { resource: r } }));
}

const { resource } = Astro.props;
const { data } = resource;
const { Content } = await resource.render();
const primaryStandard = data.standards[0];
const previewBullets = [
  `${data.resource_type} for Grade ${data.grade} ${data.subject}`,
  `NYS framework label: ${data.standards_framework}`,
  primaryStandard ? `Primary standard: ${primaryStandard.code}` : 'Standards alignment note included',
];

const confidenceColors = {
  'Full Trust': 'text-teal-400 border-teal-700/40 bg-teal-900/30',
  'High Confidence': 'text-amber-300 border-amber-700/40 bg-amber-900/20',
  'Needs Human Review': 'text-orange-300 border-orange-700/40 bg-orange-900/20',
  'Blocked': 'text-red-400 border-red-700/40 bg-red-900/20',
};
const confColor = confidenceColors[data.alignment_confidence] ?? confidenceColors['High Confidence'];

const metaDescription = `Original ${data.resource_type} for Grade ${data.grade} ${data.subject}. Built from publicly available ${data.standards_framework}. Educator-reviewed. Includes alignment notes, SDI block, and MLL/ELL scaffolds.`;

const learningResourceSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: data.title,
  description: metaDescription,
  learningResourceType: data.resource_type,
  educationalLevel: `Grade ${data.grade}`,
  teaches: data.standards.map(s => s.code).join(', '),
  educationalUse: [
    'classroom instruction',
    'intervention',
    'enrichment',
    'planning support',
  ],
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'teacher',
  },
  provider: {
    '@type': 'Organization',
    name: 'StandardCraft',
    url: 'https://standardcraftny.com',
  },
  isAccessibleForFree: false,
  inLanguage: 'en',
});
---

<Layout
  title={`${data.title} â€” StandardCraft`}
  description={metaDescription}
>
  <script type="application/ld+json" set:html={learningResourceSchema} slot="head-schema" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-[#4a5f63] mb-8 no-print">
      <a href="/" class="hover:text-teal-400">Home</a>
      <span>â€º</span>
      <a href="/resources" class="hover:text-teal-400">Resource Library</a>
      <span>â€º</span>
      <span class="text-[#e8f0f0]">{data.title}</span>
    </nav>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2 mb-4">
        <span class="tag tag-teal">{data.subject}</span>
        <span class="tag tag-gray">Grade {data.grade}</span>
        <span class="tag tag-gray">{data.grade_band}</span>
        <span class="tag tag-gray">{data.resource_type}</span>
        {data.human_review === 'Math teacher review pilot eligible' && (
          <span class="tag tag-teal">Math Review Pilot</span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold mb-3 leading-tight">{data.title}</h1>
      <p class="text-[#4a5f63]">Duration: {data.duration} Â· {data.standards_framework}</p>
    </div>

    <!-- Alignment Record Box -->
    <div class={`rounded-xl border p-5 mb-8 ${confColor}`}>
      <div class="font-semibold text-sm mb-1 uppercase tracking-wide">Alignment Record</div>
      <p class="text-xs opacity-70 mb-4">Built from publicly available New York State standards. Standard codes cited from official NYSED sources.</p>
      {data.standards.map(std => (
        <div class="mb-3 last:mb-0">
          <div class="font-mono text-sm font-semibold">{std.code}</div>
          <div class="text-sm opacity-90 mt-1">{std.text}</div>
          <div class="text-xs opacity-60 mt-1">Source: {std.source}</div>
        </div>
      ))}
      <div class="mt-4 pt-3 border-t border-current/20 flex items-center justify-between text-xs">
        <span>Confidence: <strong>{data.alignment_confidence}</strong></span>
        <span>{data.human_review}</span>
      </div>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-8">
      {data.marketplace_tags.map(tag => (
        <span class="tag tag-gray">#{tag}</span>
      ))}
    </div>

    <!-- Resource preview details -->
    <div class="grid sm:grid-cols-2 gap-4 mb-8 no-print">
      <div class="card">
        <div class="section-label mb-3">Classroom use case</div>
        <p class="text-sm text-[#415066]">
          Use this resource for classroom instruction, small-group support, intervention, enrichment, independent practice, or planning support. Preview the alignment record before choosing whether to spend your signup credit.
        </p>
      </div>
      <div class="card">
        <div class="section-label mb-3">Preview content</div>
        <ul class="space-y-2 text-sm text-[#415066]">
          {previewBullets.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <!-- Content -->
    <article class="prose prose-invert prose-teal max-w-none
      prose-headings:text-[#e8f0f0] prose-headings:font-bold
      prose-h2:text-xl prose-h2:border-b prose-h2:border-[#1e2a2d] prose-h2:pb-2
      prose-h3:text-base prose-h3:text-teal-300
      prose-p:text-[#b8cbcd] prose-li:text-[#b8cbcd]
      prose-strong:text-[#e8f0f0]
      prose-code:text-teal-300 prose-code:bg-teal-900/30 prose-code:rounded prose-code:px-1
      prose-blockquote:border-teal-600 prose-blockquote:text-[#b8cbcd]
      prose-hr:border-[#1e2a2d]
    ">
      <Content />
    </article>

    <!-- Why teachers can trust this resource -->
    <div class="mt-12 rounded-xl border border-[#1e2a2d] bg-[#0d1314] p-6 no-print">
      <div class="section-label mb-4">Why teachers can trust this resource</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {[
          { label: 'Original resource', detail: 'Created as an original instructional support â€” not copied from marketplace content.' },
          { label: 'Built from publicly available NYS standards', detail: `Standard codes and text sourced from ${data.standards_framework} â€” a publicly available official framework.` },
          { label: 'Educator-reviewed', detail: 'Reviewed for instructional clarity, classroom usability, and standards connection before publication.' },
          { label: 'Alignment notes included', detail: 'The alignment record above explains how this resource connects to the relevant NYS framework, with the exact standard code and source.' },
          { label: 'Designed for classroom use', detail: 'Supports whole-class instruction, small-group work, intervention, enrichment, independent practice, and planning support.' },
          { label: 'No student data required', detail: 'Teachers download and use this resource without entering student personally identifiable information.' },
        ].map(item => (
          <div class="flex items-start gap-2.5">
            <span class="text-teal-500 mt-0.5 shrink-0 text-sm">âœ“</span>
            <div>
              <div class="text-sm font-medium text-[#e8f0f0]">{item.label}</div>
              <div class="text-xs text-[#4a5f63] mt-0.5 leading-relaxed">{item.detail}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Footer actions -->
    <div class="mt-8 pt-8 border-t border-[#1e2a2d] flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between no-print">
      <div class="text-sm text-[#4a5f63]">
        Resource ID: {data.resource_id} Â· {data.created_for}
      </div>
      <div class="flex gap-3">
        <button onclick="window.print()" class="btn-outline text-sm py-2 px-4">Print / Save PDF</button>
        <a href="/free-resource-library" class="btn-primary text-sm py-2 px-4">Use your signup credit in the library</a>
      </div>
    </div>

    <!-- NYSED disclaimer -->
    <div class="mt-6 p-4 rounded-lg bg-[#0d1314] border border-[#1e2a2d] text-xs text-[#3a5055] leading-relaxed no-print">
      <strong class="text-[#4a5f63]">Independence notice:</strong> StandardCraft is an independent resource platform and is not affiliated with, endorsed by, or sponsored by the New York State Education Department (NYSED). This resource is original content aligned to publicly available NYS standards. It is designed to support classroom planning and instruction and does not replace district curriculum, school-approved instructional programs, or teacher professional judgment.
    </div>
  </div>
</Layout>

