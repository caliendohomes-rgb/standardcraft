---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TrustModule from '../components/TrustModule.astro';
import FaqSection from '../components/FaqSection.astro';

const allResources = await getCollection('resources');
const lessonPlans = allResources.filter(r => r.data.resource_type === 'Lesson Plan');

const faqItems = [
  {
    q: 'Are these NYS lesson plans original?',
    a: 'Yes. All StandardCraft lesson plans are created as original instructional supports — not copied from existing curriculum marketplaces or teacher resource sites. Each is reviewed for instructional clarity, classroom usability, and standards connection.',
  },
  {
    q: 'Which NYS standards are lesson plans aligned to?',
    a: 'Lesson plans cover 9+ NYS frameworks: Next Generation ELA Standards (2017), Next Generation Mathematics Learning Standards (2017), NYSSLS Science, NYS Social Studies Framework, CS & Digital Fluency, Arts Learning Standards, CDOS, Health & PE, and SDI supports. ELA and Math resources are not tagged as Common Core.',
  },
  {
    q: 'Is StandardCraft affiliated with NYSED?',
    a: 'No. StandardCraft is an independent platform and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. Resources are built from publicly available NYS standards frameworks.',
  },
  {
    q: 'Do lesson plans replace district curriculum?',
    a: 'No. StandardCraft lesson plans are designed to complement district curriculum and teacher professional judgment — not replace either. They help teachers translate publicly available NYS standards into ready-to-use classroom materials.',
  },
  {
    q: 'What does "alignment notes included" mean?',
    a: 'Each lesson plan includes a plain-English explanation of how the instructional activities connect to the relevant NYS standards framework, along with the exact standard code and official source citation.',
  },
  {
    q: 'Do I need to enter student data?',
    a: 'No. StandardCraft does not require student personally identifiable information. Teachers browse and download lesson plans without entering any student data.',
  },
];
---

<Layout
  title="NYS Lesson Plans — Original, Educator-Reviewed | StandardCraft"
  description="Original, educator-reviewed NYS lesson plans built from publicly available New York State standards. Includes SDI blocks, MLL/ELL scaffolds, and alignment notes. Independent from NYSED."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="max-w-3xl">
      <div class="section-label mb-4">NYS Lesson Plans</div>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
        Original NYS lesson plans built from publicly available standards
      </h1>
      <p class="text-lg text-[#4a5f63] mb-4 leading-relaxed">
        New York State standards describe what students should know and be able to do.
        StandardCraft lesson plans help teachers turn those expectations into practical classroom instruction —
        with SDI blocks, MLL/ELL scaffolds, alignment notes, and clear standards references included.
      </p>
      <p class="text-sm text-[#3a5055] mb-8">
        Educator-reviewed · Original content · Not affiliated with NYSED · No student data required
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/claim-free" class="btn-primary py-3 px-8">Get 1 free lesson plan →</a>
        <a href="/resources" class="btn-outline py-3 px-8">Browse all resources</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y py-8" style="border-color: var(--sc-border); background: var(--sc-sage);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {[
          { value: `${lessonPlans.length}+`, label: 'Lesson plans available' },
          { value: '9+', label: 'NYS frameworks covered' },
          { value: '0', label: 'Invented standard codes' },
          { value: '100%', label: 'Original content' },
        ].map(s => (
          <div class="text-center">
            <div class="text-2xl font-bold text-[#172438]">{s.value}</div>
            <div class="text-xs text-[#415066] mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="border-t py-16" style="border-color: var(--sc-border);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="section-label mb-4">What every lesson plan includes</div>
      <h2 class="text-2xl font-bold mb-8 max-w-xl">Standards-grounded from first line to last</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { title: 'Alignment notes', desc: 'Plain-English explanation of the NYS standard, the exact code, and the official source — before you teach the lesson.' },
          { title: 'SDI block', desc: 'Specially Designed Instruction adaptations for content, methodology, and delivery. ICT, Resource Room, and Self-Contained placements noted.' },
          { title: 'MLL/ELL scaffolds', desc: 'NYSESLAT-tiered supports across at least two proficiency bands — not generic "extra time." Vocabulary, sentence frames, and visual supports included.' },
          { title: 'Instructional sequence', desc: 'Opening, instruction, guided practice, independent practice, and closure — structured for classroom execution, not just planning.' },
          { title: 'Formative assessment', desc: 'Exit ticket or check-for-understanding woven into the lesson, aligned to the same standard as the lesson objective.' },
          { title: 'Classroom use guidance', desc: 'Explicit notes on whole-class, small-group, intervention, enrichment, and reteach applications. Flexible enough for daily planning needs.' },
        ].map(item => (
          <div class="card">
            <div class="font-semibold text-sm mb-2">{item.title}</div>
            <p class="text-xs text-[#4a5f63] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Resource grid -->
  {lessonPlans.length > 0 && (
    <section class="border-t py-16" style="border-color: var(--sc-border); background: #f7f4ee;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-bold text-[#172438]">Available lesson plans</h2>
          <a href="/resources" class="text-sm text-[#376b9b] hover:underline">Browse all resources →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {lessonPlans.slice(0, 9).map(r => (
            <a href={`/resources/${r.slug}`} class="card group hover:border-[#b5ceae] transition-colors no-underline cursor-pointer">
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="tag tag-teal">{r.data.subject}</span>
                <span class="tag tag-gray">Grade {r.data.grade}</span>
              </div>
              <h3 class="font-semibold text-sm leading-snug mb-2 text-[#172438] group-hover:text-[#376b9b] transition-colors">{r.data.title}</h3>
              <div class="flex items-center gap-2 text-xs">
                <span class="font-mono text-xs text-[#0f766e] bg-[#dce8d5] px-2 py-0.5 rounded border border-[#cadbc2]">
                  {r.data.standards[0]?.code}
                </span>
                <span class="text-[#415066]">{r.data.standards_framework}</span>
              </div>
              <p class="text-[11px] text-[#415066] mt-3 pt-2 border-t" style="border-color: var(--sc-border);">
                Alignment note included · SDI + MLL blocks · Original resource
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Positioning statement -->
  <section class="border-t py-16" style="border-color: var(--sc-border);">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-bold mb-4">Standards-based planning support, not curriculum replacement</h2>
      <p class="text-[#4a5f63] leading-relaxed text-sm">
        StandardCraft supports standards-based planning by helping educators translate publicly available New York State learning standards
        into original, classroom-ready instructional materials. It is designed to complement, not replace, district curriculum,
        teacher expertise, or school-approved instructional programs.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/claim-free" class="btn-primary py-3 px-8">Start free - browse 50 resources</a>
        <a href="/pricing" class="btn-outline py-3 px-8">View plans</a>
      </div>
    </div>
  </section>

  <TrustModule heading="Built for trust, not just search." />

  <FaqSection
    heading="Questions about StandardCraft NYS lesson plans"
    items={faqItems}
    id="faq-lesson-plans"
  />
</Layout>
