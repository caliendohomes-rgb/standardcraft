---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact — StandardCraft"
  description="Contact the StandardCraft team with questions about resources, standards alignment, or your account."
>
  <section class="max-w-xl mx-auto px-4 py-20">
    <div class="section-label mb-3">Get in touch</div>
    <h1 class="text-3xl font-bold mb-3">Contact Us</h1>
    <p class="text-[#4a5f63] mb-8">
      Questions about resources, alignment records, your account, or school pricing? We read every message.
    </p>

    <div id="success-msg" class="hidden mb-4 p-4 rounded-xl bg-[#dce8d5] border border-[#b5ceae] text-[#172438] text-sm">
      Message sent — we'll get back to you within 1–2 business days.
    </div>
    <div id="error-msg" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm"></div>

    <form id="contact-form" class="space-y-4" novalidate>
      <input type="text" name="website" autocomplete="off" tabindex="-1" aria-hidden="true"
        class="absolute opacity-0 pointer-events-none w-0 h-0 overflow-hidden" />

      <div>
        <label for="name" class="block text-sm font-semibold mb-1.5 text-[#172438]">Name <span class="text-red-500">*</span></label>
        <input type="text" id="name" name="name" required autocomplete="name" class="input-field" />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold mb-1.5 text-[#172438]">Email <span class="text-red-500">*</span></label>
        <input type="email" id="email" name="email" required autocomplete="email" class="input-field" placeholder="you@example.com" />
      </div>

      <div>
        <label for="subject" class="block text-sm font-semibold mb-1.5 text-[#172438]">Subject</label>
        <select id="subject" name="subject" class="input-field">
          <option value="General inquiry">General inquiry</option>
          <option value="Account or billing">Account or billing</option>
          <option value="Standards alignment question">Standards alignment question</option>
          <option value="Resource request">Resource request</option>
          <option value="School or district pricing">School or district pricing</option>
          <option value="Technical issue">Technical issue</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-semibold mb-1.5 text-[#172438]">Message <span class="text-red-500">*</span></label>
        <textarea id="message" name="message" rows={5} required class="input-field resize-none"></textarea>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary w-full justify-center py-3">Send message →</button>
    </form>

    <div class="mt-10 text-sm text-[#4a5f63]">
      <p>For school or district inquiries, see our <a href="/school-inquiry" class="text-[#376b9b] hover:underline">dedicated school inquiry page</a>.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const fd = new FormData(form);
    const payload = {
      name: (fd.get('name') as string).trim(),
      email: (fd.get('email') as string).trim(),
      subject: (fd.get('subject') as string),
      message: (fd.get('message') as string).trim(),
      honeypot: (fd.get('website') as string) || '',
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (res.ok) {
        successMsg.classList.remove('hidden');
        successMsg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        form.reset();
        submitBtn.textContent = 'Message sent';
        return; // Keep button disabled — submission complete
      }
      errorMsg.textContent = data.error || 'Failed to send. Please try again.';
      errorMsg.classList.remove('hidden');
    } catch {
      errorMsg.textContent = 'Network error. Please try again.';
      errorMsg.classList.remove('hidden');
    }
    submitBtn.disabled = false;
    submitBtn.textContent = 'Send message →';
  });
</script>
