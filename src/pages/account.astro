---
export const prerender = false;

import { createSupabaseServerClient, createSupabaseAdmin } from '../lib/supabase-server';
import Layout from '../layouts/Layout.astro';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/sign-in?redirect=/account');
}

const admin = createSupabaseAdmin();
const { data: profile } = await admin.from('profiles').select('full_name, email, phone').eq('id', user.id).single();
const { data: prefs } = await admin.from('user_preferences').select('subjects, grade_levels, marketing_consent').eq('user_id', user.id).maybeSingle();
const { data: sub } = await admin.from('subscriptions').select('plan, status, stripe_subscription_id, current_period_end').eq('user_id', user.id).maybeSingle();

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<Layout
  title="Account Settings — StandardCraft"
  description="Manage your StandardCraft account, preferences, and subscription."
  noIndex={true}
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-8">
      <div class="section-label mb-1">Settings</div>
      <h1 class="text-3xl font-bold">Account</h1>
    </div>

    <div id="success-msg" class="hidden mb-4 p-3 rounded-lg bg-teal-950/60 border border-teal-700 text-teal-200 text-sm"></div>
    <div id="error-msg" class="hidden mb-4 p-3 rounded-lg bg-red-950/60 border border-red-800 text-red-300 text-sm"></div>

    <!-- Profile -->
    <div class="card mb-6">
      <h2 class="font-bold text-lg mb-4">Profile</h2>
      <form id="profile-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1.5">Full name</label>
          <input type="text" name="full_name" value={profile?.full_name ?? ''} required
            class="w-full px-3 py-2.5 rounded-lg bg-[#0a0e0f] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Email</label>
          <input type="email" value={profile?.email ?? user.email ?? ''} disabled
            class="w-full px-3 py-2.5 rounded-lg bg-[#111618] border border-[#1e2a2d] text-[#4a5f63] text-sm cursor-not-allowed" />
          <p class="text-xs text-[#4a5f63] mt-1">Email cannot be changed. Contact support if needed.</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1.5">Phone (optional)</label>
          <input type="tel" name="phone" value={profile?.phone ?? ''}
            class="w-full px-3 py-2.5 rounded-lg bg-[#0a0e0f] border border-[#1e2a2d] text-[#e8f0f0] focus:outline-none focus:border-teal-600 text-sm" />
        </div>
        <button type="submit" class="btn-outline text-sm py-2 px-4" id="profile-btn">Save profile</button>
      </form>
    </div>

    <!-- Subscription -->
    <div class="card mb-6">
      <h2 class="font-bold text-lg mb-4">Subscription</h2>
      {!sub ? (
        <div>
          <p class="text-[#4a5f63] text-sm mb-4">You're on the free plan.</p>
          <a href="/pricing" class="btn-primary text-sm py-2 px-4">Upgrade plan →</a>
        </div>
      ) : (
        <div class="text-sm space-y-2">
          <div class="flex justify-between">
            <span class="text-[#4a5f63]">Plan</span>
            <span class="font-medium capitalize">{sub.plan}</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#4a5f63]">Status</span>
            <span class={`font-medium ${sub.status === 'active' ? 'text-teal-400' : 'text-amber-400'}`}>{sub.status}</span>
          </div>
          {sub.current_period_end && (
            <div class="flex justify-between">
              <span class="text-[#4a5f63]">Next renewal</span>
              <span>{formatDate(sub.current_period_end)}</span>
            </div>
          )}
          <div class="pt-3 border-t border-[#1e2a2d] flex gap-3">
            <a href="/pricing" class="btn-outline text-sm py-2 px-4">Change plan</a>
          </div>
        </div>
      )}
    </div>

    <!-- Preferences -->
    <div class="card mb-6">
      <h2 class="font-bold text-lg mb-4">Teaching Preferences</h2>
      <form id="prefs-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-2">Subjects</label>
          <div class="grid grid-cols-2 gap-2 text-sm">
            {['ELA', 'Math', 'Science', 'Social Studies', 'CS / Technology', 'Arts', 'World Languages', 'Health / PE', 'Special Education / SDI'].map(s => (
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="subjects" value={s}
                  checked={(prefs?.subjects ?? []).includes(s)}
                  class="accent-teal-500" />
                <span class="text-[#4a5f63]">{s}</span>
              </label>
            ))}
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-2">Grade levels</label>
          <div class="flex flex-wrap gap-3 text-sm">
            {['K-2', '3-5', '6-8', '9-12'].map(g => (
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="checkbox" name="grade_levels" value={g}
                  checked={(prefs?.grade_levels ?? []).includes(g)}
                  class="accent-teal-500" />
                <span class="text-[#4a5f63]">{g}</span>
              </label>
            ))}
          </div>
        </div>
        <label class="flex items-start gap-2 cursor-pointer">
          <input type="checkbox" name="marketing_consent" checked={prefs?.marketing_consent === true} class="accent-teal-500 mt-0.5" />
          <span class="text-xs text-[#4a5f63]">Receive updates about new resources and NYS standards changes.</span>
        </label>
        <button type="submit" class="btn-outline text-sm py-2 px-4">Save preferences</button>
      </form>
    </div>

    <!-- Sign out -->
    <div class="flex items-center justify-between text-sm pt-4">
      <a href="/dashboard" class="text-teal-400 hover:underline">← Back to Dashboard</a>
      <form method="POST" action="/api/signout">
        <button type="submit" class="text-[#4a5f63] hover:text-[#e8f0f0] transition-colors">Sign out</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { createSupabaseBrowserClient } from '../lib/supabase';

  const successMsg = document.getElementById('success-msg') as HTMLDivElement;
  const errorMsg = document.getElementById('error-msg') as HTMLDivElement;

  function showSuccess(msg: string) {
    successMsg.textContent = msg;
    successMsg.classList.remove('hidden');
    errorMsg.classList.add('hidden');
    setTimeout(() => successMsg.classList.add('hidden'), 3000);
  }

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorMsg.classList.remove('hidden');
    successMsg.classList.add('hidden');
  }

  // Profile form
  document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const btn = document.getElementById('profile-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Saving…';

    const supabase = createSupabaseBrowserClient();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { showError('Session expired. Please sign in again.'); return; }

    // Update via Supabase directly (users can update their own profile via RLS)
    const { error } = await supabase.from('profiles').update({
      full_name: (fd.get('full_name') as string).trim(),
      phone: (fd.get('phone') as string).trim() || null,
    }).eq('id', user.id);

    if (error) {
      showError('Could not save profile. Please try again.');
    } else {
      showSuccess('Profile saved.');
    }
    btn.disabled = false;
    btn.textContent = 'Save profile';
  });

  // Preferences form
  document.getElementById('prefs-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);

    const supabase = createSupabaseBrowserClient();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { showError('Session expired. Please sign in again.'); return; }

    const { error } = await supabase.from('user_preferences').update({
      subjects: fd.getAll('subjects') as string[],
      grade_levels: fd.getAll('grade_levels') as string[],
      marketing_consent: fd.has('marketing_consent'),
    }).eq('user_id', user.id);

    if (error) {
      showError('Could not save preferences. Please try again.');
    } else {
      showSuccess('Preferences saved.');
    }
  });
</script>
