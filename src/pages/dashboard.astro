---
export const prerender = false;

import { createSupabaseServerClient, createSupabaseAdmin } from '../lib/supabase-server';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/sign-in?redirect=/dashboard');
}

const admin = createSupabaseAdmin();

const [profileResult, creditsResult, downloadsResult, subResult, resourcesResult] = await Promise.all([
  admin.from('profiles').select('full_name, email').eq('id', user.id).maybeSingle(),
  admin.from('credits').select('balance, lifetime_earned, lifetime_spent').eq('user_id', user.id).maybeSingle(),
  admin.from('downloads').select('resource_slug, downloaded_at').eq('user_id', user.id).order('downloaded_at', { ascending: false }).limit(5),
  admin.from('subscriptions').select('plan, status, current_period_end').eq('user_id', user.id).maybeSingle(),
  getCollection('resources'),
]);

const profile = profileResult.data;
const credits = creditsResult.data ?? { balance: 0, lifetime_earned: 0, lifetime_spent: 0 };
const recentDownloads = downloadsResult.data ?? [];
const subscription = subResult.data;
const resourceTitleMap = Object.fromEntries((resourcesResult ?? []).map(r => [r.id, r.data.title]));
const resourceCount = (resourcesResult ?? []).length;

const checkoutSuccess = Astro.url.searchParams.get('checkout') === 'success';
const firstName = profile?.full_name?.split(' ')[0] ?? 'Teacher';

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const planLabel: Record<string, string> = {
  classroom: 'Classroom — $29/mo',
  pro: 'Pro — $69/mo',
  school: 'School — contact billing',
};
---

<Layout
  title="Dashboard — StandardCraft"
  description="Your StandardCraft dashboard."
  noIndex={true}
>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">

    {checkoutSuccess && (
      <div class="mb-6 p-4 rounded-xl bg-[#dce8d5] border border-[#b5ceae] text-[#172438] text-sm">
        🎉 <strong>Subscription active!</strong> Your credits have been added to your account.
      </div>
    )}

    <div class="flex items-center justify-between mb-10">
      <div>
        <div class="section-label mb-1">Your Dashboard</div>
        <h1 class="text-3xl font-bold">Welcome back, {firstName}</h1>
      </div>
      <a href="/free-resource-library" class="btn-primary text-sm py-2 px-5">Browse Library →</a>
    </div>

    <!-- Stats row -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      {[
        { label: 'Credits remaining', value: credits.balance, color: 'text-[#376b9b]' },
        { label: 'Lifetime credits earned', value: credits.lifetime_earned, color: 'text-[#172438]' },
        { label: 'Resources downloaded', value: credits.lifetime_spent, color: 'text-[#172438]' },
        { label: 'Current plan', value: subscription ? (planLabel[subscription.plan] ?? subscription.plan) : 'Free trial', color: 'text-[#172438]', small: true },
      ].map(s => (
        <div class="card">
          <div class={`${s.small ? 'text-base' : 'text-3xl'} font-bold ${s.color} mb-1`}>{s.value}</div>
          <div class="text-xs text-[#4a5f63]">{s.label}</div>
        </div>
      ))}
    </div>

    <!-- Plan & subscription -->
    <div class="card mb-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg">Subscription</h2>
        {(!subscription || subscription.status !== 'active') && (
          <a href="/pricing" class="btn-primary text-sm py-1.5 px-4">Upgrade plan</a>
        )}
        {subscription?.status === 'active' && (
          <a href="/account" class="btn-outline text-sm py-1.5 px-4">Manage</a>
        )}
      </div>
      {!subscription && (
        <div>
          <div class="text-[#4a5f63] text-sm mb-4">You're on the free trial. Upgrade to get monthly credits every month.</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="/pricing" class="card transition-colors cursor-pointer no-underline block">
              <div class="font-semibold mb-1 text-[#172438]">Classroom</div>
              <div class="text-2xl font-bold text-[#376b9b] mb-1">$29<span class="text-base text-[#415066]">/mo</span></div>
              <div class="text-sm text-[#415066]">8 credits/month</div>
            </a>
            <a href="/pricing" class="card border-t-4 transition-colors cursor-pointer no-underline block" style="border-top-color: var(--sc-gold);">
              <div class="tag tag-amber mb-2 self-start inline-block">Most Popular</div>
              <div class="font-semibold mb-1 text-[#172438]">Pro</div>
              <div class="text-2xl font-bold text-[#376b9b] mb-1">$69<span class="text-base text-[#415066]">/mo</span></div>
              <div class="text-sm text-[#415066]">20 credits/month</div>
            </a>
          </div>
        </div>
      )}
      {subscription && (
        <div class="text-sm text-[#4a5f63]">
          <span class="text-[#172438] font-semibold">{planLabel[subscription.plan] ?? subscription.plan}</span>
          {subscription.status === 'active' && subscription.current_period_end && (
            <span> · Renews {formatDate(subscription.current_period_end)}</span>
          )}
          {subscription.status !== 'active' && (
            <span class="text-[#b08968]"> · {subscription.status}</span>
          )}
        </div>
      )}
    </div>

    <!-- Recent downloads -->
    <div class="card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg">Recent Downloads</h2>
        <a href="/free-resource-library" class="text-sm text-[#376b9b] hover:underline">View all →</a>
      </div>
      {recentDownloads.length === 0 ? (
        <div class="text-[#4a5f63] text-sm py-4 text-center">
          No downloads yet.
          <a href="/free-resource-library" class="text-[#376b9b] hover:underline ml-1">Browse the library →</a>
        </div>
      ) : (
        <ul class="space-y-3">
          {recentDownloads.map((d: any) => (
            <li class="flex items-center justify-between gap-3 text-sm border-t border-[#e4dac8] pt-3 first:border-0 first:pt-0">
              <a href={`/resources/${d.resource_slug}`} class="text-[#172438] font-medium text-xs hover:text-[#376b9b] transition-colors leading-snug">
                {resourceTitleMap[d.resource_slug] ?? d.resource_slug}
              </a>
              <span class="text-[#415066] text-xs shrink-0">{formatDate(d.downloaded_at)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Partner / shape the roadmap -->
    <a href="/suggest-lesson" class="block no-underline mt-6 rounded-xl p-5 sm:p-6 transition-transform hover:-translate-y-0.5"
       style="background: linear-gradient(135deg, var(--sc-navy) 0%, #1d3256 100%);">
      <div class="flex items-center justify-between gap-4">
        <div>
          <div class="text-[11px] font-bold tracking-[0.12em] uppercase mb-1.5" style="color: var(--sc-gold);">Partner with StandardCraft</div>
          <div class="text-white font-display text-xl font-semibold mb-1">Shape the roadmap →</div>
          <div class="text-sm max-w-lg" style="color: #a8bfcf;">
            We add <strong class="text-white">25+ new lesson plans every month</strong>. Suggest the standards and topics we build next — your requests go straight to our development board.
          </div>
        </div>
        <span class="hidden sm:flex shrink-0 items-center justify-center w-11 h-11 rounded-full text-lg"
              style="background: rgba(255,255,255,0.1); color: var(--sc-gold);">✎</span>
      </div>
    </a>

    <!-- Quick links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
      {[
        { href: '/free-resource-library', label: 'Resource Library', desc: `${resourceCount} verified resources` },
        { href: '/suggest-lesson', label: 'Suggest a Lesson', desc: 'Direct what we build next' },
        { href: '/account', label: 'Account Settings', desc: 'Profile, password, billing' },
      ].map(l => (
        <a href={l.href} class="card hover:border-[#b5ceae] transition-colors cursor-pointer no-underline block">
          <div class="font-semibold text-sm mb-1">{l.label}</div>
          <div class="text-xs text-[#4a5f63]">{l.desc}</div>
        </a>
      ))}
    </div>

    <!-- Sign out -->
    <div class="mt-10 text-center">
      <form method="POST" action="/api/signout">
        <button type="submit" class="text-sm text-[#415066] hover:text-[#172438] transition-colors">Sign out</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  // Conversion event on return from Stripe checkout — fire once, then strip
  // the query param so a refresh doesn't double-count the purchase.
  const params = new URLSearchParams(window.location.search);
  if (params.get('checkout') === 'success') {
    (window as any).plausible?.('Purchase Complete');
    history.replaceState(null, '', window.location.pathname);
  }
</script>
