---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TrustModule from '../components/TrustModule.astro';
import FaqSection from '../components/FaqSection.astro';

const allResources = await getCollection('resources');
const scienceResources = allResources.filter(r =>
  r.data.subject === 'Science' || r.data.subject === 'Science / NYSSLS'
);

const faqItems = [
  {
    q: 'What is NYSSLS?',
    a: 'NYSSLS stands for New York State P-12 Science Learning Standards, adopted in 2017. They are three-dimensional standards that integrate disciplinary core ideas (DCIs), science and engineering practices (SEPs), and crosscutting concepts (CCCs). StandardCraft resources are grounded in the publicly available NYSSLS framework.',
  },
  {
    q: 'Are StandardCraft science resources original?',
    a: 'Yes. All science resources are created as original instructional supports — not copied from marketplace content. Each is reviewed for instructional clarity and alignment to the relevant NYSSLS performance expectation.',
  },
  {
    q: 'Do science resources include all three dimensions?',
    a: 'Yes. StandardCraft science resources are designed to engage all three NYSSLS dimensions where applicable: disciplinary core ideas, science and engineering practices, and crosscutting concepts. Alignment notes explain which dimensions the resource addresses.',
  },
  {
    q: 'Is StandardCraft affiliated with NYSED?',
    a: 'No. StandardCraft is independent and is not affiliated with, endorsed by, or sponsored by the New York State Education Department. Resources are built from the publicly available NYSSLS framework.',
  },
  {
    q: 'Are science resources suitable for intervention and enrichment?',
    a: 'Yes. Science resources are designed for classroom use, intervention, enrichment, and planning support. SDI blocks and MLL/ELL scaffolds are included in every resource.',
  },
  {
    q: 'Do I need student data to access science resources?',
    a: 'No. Teachers access science resources without entering student personally identifiable information.',
  },
];
---

<Layout
  title="NYSSLS Science Resources — Original, 3-Dimensional | StandardCraft"
  description="Original, educator-reviewed NYSSLS science resources built from publicly available NYS P-12 Science Learning Standards. Three-dimensional alignment. SDI blocks and MLL/ELL scaffolds included."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16">
    <div class="max-w-3xl">
      <div class="section-label mb-4">NYSSLS Science Resources</div>
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">
        3-Dimensional science resources built from publicly available NYSSLS
      </h1>
      <p class="text-lg text-[#4a5f63] mb-4 leading-relaxed">
        Original, educator-reviewed science lesson plans and classroom resources grounded in the NYS P-12 Science Learning Standards (NYSSLS, 2017).
        Resources engage disciplinary core ideas, science and engineering practices, and crosscutting concepts —
        with alignment notes, SDI blocks, and MLL/ELL scaffolds included.
      </p>
      <div class="flex flex-wrap gap-2 mb-8">
        <span class="tag tag-amber text-xs">NYSSLS — 3 Dimensions</span>
        <span class="tag tag-gray text-xs">Grades K–12</span>
        <span class="tag tag-gray text-xs">Educator-reviewed</span>
      </div>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/claim-free" class="btn-primary py-3 px-8">Get 1 free science resource →</a>
        <a href="/resources" class="btn-outline py-3 px-8">Browse all resources</a>
      </div>
    </div>
  </section>

  <section class="border-y py-8" style="border-color: var(--sc-border); background: var(--sc-sage);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-3 sm:grid-cols-3 gap-6">
        {[
          { value: 'DCIs', label: 'Disciplinary Core Ideas', desc: 'Physical, life, earth & space, engineering' },
          { value: 'SEPs', label: 'Science & Engineering Practices', desc: 'Asking questions, modeling, investigation, explanation, argument' },
          { value: 'CCCs', label: 'Crosscutting Concepts', desc: 'Patterns, cause/effect, systems, energy, structure/function' },
        ].map(s => (
          <div class="text-center">
            <div class="text-xl font-bold text-[#172438] mb-1">{s.value}</div>
            <div class="text-xs font-semibold text-[#172438]">{s.label}</div>
            <div class="text-xs text-[#415066] mt-1">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {scienceResources.length > 0 && (
    <section class="border-t py-16" style="border-color: var(--sc-border); background: #f7f4ee;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-6">
          <h2 class="text-2xl font-bold text-[#172438]">Available NYSSLS resources</h2>
          <a href="/resources" class="text-sm text-[#376b9b] hover:underline">Browse all →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {scienceResources.map(r => (
            <a href={`/resources/${r.id}`} class="card group hover:border-[#b5ceae] transition-colors no-underline cursor-pointer">
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="tag tag-amber">Science</span>
                <span class="tag tag-gray">Grade {r.data.grade}</span>
                <span class="tag tag-gray">{r.data.resource_type}</span>
              </div>
              <h3 class="font-semibold text-sm leading-snug mb-2 text-[#172438] group-hover:text-[#376b9b] transition-colors">{r.data.title}</h3>
              <div class="flex items-center gap-2 text-xs">
                <span class="font-mono text-xs text-[#0f766e] bg-[#dce8d5] px-2 py-0.5 rounded border border-[#cadbc2]">
                  {r.data.standards[0]?.code}
                </span>
                <span class="text-[#415066]">NYSSLS</span>
              </div>
              <p class="text-[11px] text-[#415066] mt-3 pt-2 border-t" style="border-color: var(--sc-border);">
                3-Dimensional · Alignment note included · Original resource
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <TrustModule heading="Built for trust, not just search." subjectContext="Science (NYSSLS)" />

  <FaqSection
    heading="Questions about StandardCraft NYSSLS science resources"
    items={faqItems}
    id="faq-science"
  />
</Layout>
